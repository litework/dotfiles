#!/usr/bin/env python3
"""weather — Markham, Ontario weather from Open-Meteo (no account; city-level coordinates only).

  weather bar      JSON for the waybar module (icon class + temperature)
  weather json     the cached forecast for quick-panel (refreshing it if stale)
  weather update   force a refresh

Results are cached in ~/.cache/weather.json for 15 minutes.
"""
import json
import os
import sys
import time
import urllib.request

LAT, LON, PLACE = 43.9, -79.3, "Markham"
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "weather.json")
MAX_AGE = 15 * 60
URL = ("https://api.open-meteo.com/v1/forecast"
       f"?latitude={LAT}&longitude={LON}&timezone=auto&forecast_days=7"
       "&current=temperature_2m,apparent_temperature,relative_humidity_2m,wind_speed_10m,weather_code,is_day"
       "&hourly=temperature_2m,weather_code,is_day,precipitation_probability"
       "&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,sunrise,sunset")

# WMO weather code -> (description, Papirus icon, night icon or None)
CODES = {
    0: ("Clear", "weather-clear", "weather-clear-night"),
    1: ("Mostly clear", "weather-few-clouds", "weather-few-clouds-night"),
    2: ("Partly cloudy", "weather-clouds", "weather-clouds-night"),
    3: ("Cloudy", "weather-overcast", None),
    45: ("Fog", "weather-fog", None), 48: ("Freezing fog", "weather-fog", None),
    51: ("Light drizzle", "weather-showers-scattered", None), 53: ("Drizzle", "weather-showers-scattered", None),
    55: ("Heavy drizzle", "weather-showers", None),
    56: ("Freezing drizzle", "weather-freezing-rain", None), 57: ("Freezing drizzle", "weather-freezing-rain", None),
    61: ("Light rain", "weather-showers-scattered", None), 63: ("Rain", "weather-showers", None),
    65: ("Heavy rain", "weather-showers", None),
    66: ("Freezing rain", "weather-freezing-rain", None), 67: ("Freezing rain", "weather-freezing-rain", None),
    71: ("Light snow", "weather-snow-scattered", None), 73: ("Snow", "weather-snow", None),
    75: ("Heavy snow", "weather-snow", None), 77: ("Snow grains", "weather-snow-scattered", None),
    80: ("Showers", "weather-showers-scattered", None), 81: ("Showers", "weather-showers", None),
    82: ("Heavy showers", "weather-showers", None),
    85: ("Snow showers", "weather-snow-scattered", None), 86: ("Snow showers", "weather-snow", None),
    95: ("Thunderstorm", "weather-storm", None), 96: ("Thunderstorm, hail", "weather-storm", None),
    99: ("Thunderstorm, hail", "weather-storm", None),
}


def describe(code, is_day=1):
    desc, icon, night = CODES.get(code, ("Unknown", "weather-none-available", None))
    return desc, (night if night and not is_day else icon)


def load(force=False):
    try:
        with open(CACHE) as f:
            data = json.load(f)
    except (OSError, ValueError):
        data = None
    if force or not data or time.time() - data.get("_fetched", 0) > MAX_AGE:
        try:
            req = urllib.request.Request(URL, headers={"User-Agent": "dotfiles-weather/1.0"})
            fresh = json.load(urllib.request.urlopen(req, timeout=10))
            fresh["_fetched"] = time.time()
            fresh["_place"] = PLACE
            os.makedirs(os.path.dirname(CACHE), exist_ok=True)
            with open(CACHE + ".tmp", "w") as f:
                json.dump(fresh, f)
            os.replace(CACHE + ".tmp", CACHE)
            data = fresh
        except Exception:
            pass    # offline: keep using the cache
    return data


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "bar"
    data = load(force=(cmd == "update"))
    if cmd == "json":
        print(json.dumps(data or {}))
    elif cmd == "bar":
        if not data:
            print(json.dumps({"text": "", "tooltip": "Weather unavailable"}))
            return 0
        cur = data["current"]
        desc, icon = describe(cur["weather_code"], cur.get("is_day", 1))
        print(json.dumps({"text": f"{round(cur['temperature_2m'])}°", "class": icon.replace("weather-", "w-"),
                          "tooltip": f"{PLACE}: {desc}, feels like {round(cur['apparent_temperature'])}°"}))
    elif cmd != "update":
        print(__doc__.strip(), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
