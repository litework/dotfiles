def place_name():
    try:
        with open(os.path.expanduser("~/.config/location.conf")) as f:
            for line in f:
                if line.strip().startswith("PLACE="):
                    return line.strip().split("=", 1)[1]
    except OSError:
        pass
    return "your area"
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]|\x01|\x02")

