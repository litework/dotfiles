        self.selected = 0
        self.windows = []
        self.query = ""

        self.search = Gtk.SearchEntry(placeholder_text="Search apps, files, windows, or type a sum",
                                      margin_bottom=8)
        self.search.connect("search-changed", self._on_search)
        self.search.connect("activate", lambda *_: self._activate_selected())
