    ("system-reboot-symbolic", "Restart", "Restart the computer", ["restart", "reboot"], "run", ["systemctl", "reboot"]),
    ("weather-clear-night-symbolic", "Sleep", "Suspend to RAM", ["sleep", "suspend"], "run", ["systemctl", "suspend"]),
    ("system-lock-screen-symbolic", "Lock", "Lock the screen", ["lock"], "run", LOCK_CMD),
    ("system-log-out-symbolic", "Sign out", "Leave the desktop", ["sign out", "log out", "logout", "logoff"],
     "run", ["swaymsg", "exit"]),
    ("network-wireless-symbolic", "Wi-Fi", "Settings", ["wifi", "wi-fi", "network", "internet"], "page", "wifi"),
