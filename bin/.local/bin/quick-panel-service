def match_command(query, keywords):
    """True if the query starts a keyword (≥3 letters typed) or a keyword starts the query ("shutdown now")."""
    q = " ".join(query.lower().replace("-", " ").split())
    for k in keywords:
        k = k.replace("-", " ")
        if q.startswith(k) or (len(q) >= 3 and k.startswith(q)):
            return True
    return False


class StartPage(Page):
    """Start menu: search, pinned apps, all apps, settings and power."""
    has_header = False
    has_status = False
    has_switch = False
    has_list = False
    has_refresh = False
    anchor = "center"
    width = 520

    def __init__(self, panel):
        super().__init__(panel)
        self.apps = []
