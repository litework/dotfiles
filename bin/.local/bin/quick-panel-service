        self.add_body(self.search, self.views, Gtk.Separator(margin_top=6), bottom)

    # Apps --------------------------------------------------------------
    def _pinned(self):
        """[(desktop id, short label or None)] from lines like `microsoft-edge.desktop = Edge`."""
        pins = []
        for line in read(PINNED_FILE).splitlines():
            line = line.strip()
            if line and not line.startswith("#"):
                app_id, _, label = line.partition("=")
                pins.append((app_id.strip(), label.strip() or None))
        return pins

    def _pinned_ids(self):
        return [app_id for app_id, _ in self._pinned()]

    def _set_pinned(self, ids):
        labels = dict(self._pinned())
        os.makedirs(os.path.dirname(PINNED_FILE), exist_ok=True)
        with open(PINNED_FILE, "w") as f:
            f.write("".join(f"{i} = {labels[i]}\n" if labels.get(i) else f"{i}\n" for i in ids))
        self._build()

    def _build(self):
        seen, apps = set(), []
        for app in Gio.AppInfo.get_all():
            if app.should_show() and app.get_id() not in seen:
                seen.add(app.get_id())
                apps.append(app)
        self.apps = sorted(apps, key=lambda a: a.get_display_name().lower())
        by_id = {a.get_id(): a for a in self.apps}

        self.grid.remove_all()
        for app_id, label in self._pinned():
            if app_id in by_id:
                self.grid.append(self._app_button(by_id[app_id], tile=True, name=label))
        while (child := self.all_list.get_first_child()) is not None:
            self.all_list.remove(child)
        for app in self.apps:
            self.all_list.append(self._app_button(app))

    def _app_button(self, app, tile=False, name=None):
        b = Gtk.Button(tooltip_text=app.get_description() or app.get_display_name())
        b.add_css_class("flat")
        b.add_css_class("qp-app")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL if tile else Gtk.Orientation.HORIZONTAL,
                      spacing=6 if tile else 12)
        icon = app.get_icon()
        image = Gtk.Image.new_from_gicon(icon) if icon else Gtk.Image(icon_name="application-x-executable")
        image.set_pixel_size(32 if tile else 24)
        if tile:
            # Short name from the pinned file; long names wrap instead of being cut off.
            label = Gtk.Label(label=name or app.get_display_name(), wrap=True, wrap_mode=2, max_width_chars=11,
                              justify=Gtk.Justification.CENTER)
            label.add_css_class("qp-app-label")
        else:
            label = Gtk.Label(label=app.get_display_name(), ellipsize=3, max_width_chars=50, xalign=0)
        box.append(image)
        box.append(label)
        b.set_child(box)
        b.connect("clicked", lambda *_: self.launch(app))
        right = Gtk.GestureClick(button=3)
        right.connect("pressed", lambda *_: self._pin_menu(b, app))
        b.add_controller(right)
        return b

    def _pin_menu(self, widget, app):
        ids = self._pinned_ids()
        pinned = app.get_id() in ids
        item = Gtk.Button(label="Unpin from Start" if pinned else "Pin to Start")
        item.add_css_class("flat")
        popover = Gtk.Popover(child=item)
        popover.set_parent(widget)
        popover.connect("closed", lambda p: GLib.idle_add(p.unparent))

        def toggle(*_):
            popover.popdown()
            self._set_pinned([i for i in ids if i != app.get_id()] if pinned else ids + [app.get_id()])
        item.connect("clicked", toggle)
        popover.popup()

    def launch(self, app):
        self.panel.hide_panel()
        if isinstance(app, DesktopAppInfo) and app.get_boolean("Terminal"):
            cmd = re.sub(r"%[a-zA-Z]", "", app.get_commandline() or "")
            spawn(["foot", *shlex.split(cmd)])
            return
        ctx = Gdk.Display.get_default().get_app_launch_context()
        ctx.unsetenv("LD_PRELOAD")
        try:
            app.launch([], ctx)
        except GLib.Error as e:
            spawn(["notify-send", "Couldn't start " + app.get_display_name(), e.message])

    # Search ------------------------------------------------------------
    def _result_row(self, icon, title, subtitle, action):
        """A selectable search result; icon is a Gio.Icon or an icon name."""
        b = Gtk.Button()
        b.add_css_class("flat")
        b.add_css_class("qp-app")
        box = Gtk.Box(spacing=12)
        img = Gtk.Image.new_from_gicon(icon) if isinstance(icon, Gio.Icon) else Gtk.Image(icon_name=icon)
        img.set_pixel_size(24)
        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
        labels.append(Gtk.Label(label=title, xalign=0, ellipsize=3, max_width_chars=50))
        if subtitle:
            sub = Gtk.Label(label=subtitle, xalign=0, ellipsize=1, max_width_chars=60)
            sub.add_css_class("qp-sub")
            labels.append(sub)
        box.append(img)
        box.append(labels)
        b.set_child(box)
        b.connect("clicked", lambda *_: action())
        self.items.append((b, action))
        self.result_list.append(b)
        return b

    def _heading(self, text):
        label = Gtk.Label(label=text, xalign=0, margin_top=6, margin_start=4)
        label.add_css_class("qp-section")
        self.result_list.append(label)

    def _select(self, index):
        if not self.items:
            return
        self.selected = max(0, min(index, len(self.items) - 1))
        for i, (button, _) in enumerate(self.items):
            (button.add_css_class if i == self.selected else button.remove_css_class)("qp-selected")
        # Keep the highlighted row visible.
        button = self.items[self.selected][0]
        ok, bounds = button.compute_bounds(self.result_list)
        if ok:
            adj = self.result_scroll.get_vadjustment()
            top, bottom = bounds.get_y(), bounds.get_y() + bounds.get_height()
            if top < adj.get_value():
                adj.set_value(top)
            elif bottom > adj.get_value() + adj.get_page_size():
                adj.set_value(bottom - adj.get_page_size())

    def _on_search_key(self, _ctrl, keyval, _code, _state):
        if keyval in (Gdk.KEY_Down, Gdk.KEY_Tab):
            self._select(self.selected + 1)
            return True
        if keyval in (Gdk.KEY_Up, Gdk.KEY_ISO_Left_Tab):
            self._select(self.selected - 1)
            return True
        return False

    def _activate_selected(self):
        if self.items:
            self.items[self.selected][1]()

    def _on_search(self, entry):
        raw = entry.get_text().strip()
        q = raw.lower()
        self.query = q
        self.items = []
        self.selected = 0
        while (child := self.result_list.get_first_child()) is not None:
            self.result_list.remove(child)
        if not q:
            self.views.set_visible_child_name("pinned")
            return
        self.views.set_visible_child_name("search")

        commands = [c for c in START_COMMANDS if match_command(raw, c[3])]
        if commands:
            self._heading("System")
            for icon, title, sub, _kw, kind, target in commands:
                self._result_row(icon, title, sub, lambda k=kind, t=target: self._run_command(k, t))

        value = calculate(raw)
        if value is not None:
            self._heading("Calculator")
            self._result_row("accessories-calculator", f"= {value}", "Press Enter to copy",
                             lambda v=value: self._copy(v))

        scored = []
        for app in self.apps:
            name = app.get_display_name().lower()
            extra = []
            if isinstance(app, DesktopAppInfo):
                extra = [app.get_generic_name() or "", " ".join(app.get_keywords() or [])]
            hay = " ".join([name, *extra, app.get_executable() or ""]).lower()
            if name.startswith(q):
                rank = 0
            elif any(w.startswith(q) for w in name.split()):
                rank = 1
            elif q in hay:
                rank = 2
            else:
                continue
            scored.append((rank, name, app))
        scored.sort(key=lambda t: t[:2])
        if scored:
            self._heading("Apps")
            for _, _, app in scored[:8]:
                self._result_row(app.get_icon() or "application-x-executable", app.get_display_name(),
                                 app.get_generic_name() if isinstance(app, DesktopAppInfo) else None,
                                 lambda a=app: self.launch(a))

        wins = [w for w in self.windows if q in w["title"].lower() or q in w["app"].lower()]
        if wins:
            self._heading("Open windows")
            for w in wins[:5]:
                self._result_row(w["icon"], w["title"], f"Switch to · workspace {w['workspace']}",
                                 lambda c=w["id"]: (self.panel.hide_panel(), spawn(["swaymsg", f"[con_id={c}] focus"])))

        if len(q) >= 3:
            run(["fd", "--ignore-case", "--max-depth", "5", "--max-results", "8", "--fixed-strings",
                 "--absolute-path", "--", raw, os.path.expanduser("~")],
                lambda ok, out, query=q: self._add_files(query, out))

        if not self.items:
            self._no_results()
        self._select(0)

    def _run_command(self, kind, target):
        if kind == "run":
            self.panel.hide_panel()
            spawn(target)
        elif kind == "page":
            self.panel.open_root(target)
        elif kind == "wallpaper":
            self.panel.pages["settings"].pick_wallpaper()

    def _no_results(self):
        none = Gtk.Label(label="Searching…" if len(self.query) >= 3 else "No results", margin_top=20)
        none.add_css_class("qp-sub")
        none.qp_placeholder = True
        self.result_list.append(none)

    def _add_files(self, query, out):
        if query != self.query:
            return   # typed something else since
        child = self.result_list.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            if getattr(child, "qp_placeholder", False):
                self.result_list.remove(child)
            child = nxt
        paths = [l.rstrip("/") for l in out.splitlines() if l.strip()]
        if not paths:
            if not self.items:
                none = Gtk.Label(label="No results", margin_top=20)
                none.add_css_class("qp-sub")
                self.result_list.append(none)
            return
        self._heading("Files and folders")
        home = os.path.expanduser("~")
        for path in paths:
            f = Gio.File.new_for_path(path)
            try:
                info = f.query_info("standard::icon", Gio.FileQueryInfoFlags.NONE, None)
                icon = info.get_icon()
            except GLib.Error:
                icon = "text-x-generic"
            parent = os.path.dirname(path).replace(home, "~", 1)
            self._result_row(icon, os.path.basename(path), parent, lambda u=f.get_uri(): self._open_uri(u))
        if len(self.items) == len(paths):   # files are the only results
            self._select(0)

    def _open_uri(self, uri):
        self.panel.hide_panel()
        ctx = Gdk.Display.get_default().get_app_launch_context()
        ctx.unsetenv("LD_PRELOAD")
        try:
            Gio.AppInfo.launch_default_for_uri(uri, ctx)
        except GLib.Error as e:
            spawn(["notify-send", "Couldn't open file", e.message])

    def _copy(self, value):
        self.panel.hide_panel()
        run(["wl-copy", str(value)])
        spawn(["notify-send", "-a", "Calculator", f"Copied {value}"])

    def _load_windows(self, ok, out):
        windows = []
        try:
            tree = json.loads(out)
        except ValueError:
            return

        def walk(node, ws=None):
            if node.get("type") == "workspace":
                ws = node.get("name")
            if node.get("pid") and ws and not ws.startswith("__"):
                app = node.get("app_id") or (node.get("window_properties") or {}).get("class") or ""
                info = None
                for cand in (app, app.lower()):
                    try:
                        info = DesktopAppInfo.new(cand + ".desktop")
                    except TypeError:
                        info = None
                    if info:
                        break
                windows.append({"id": node["id"], "title": node.get("name") or app, "app": app,
                                "workspace": ws, "icon": (info and info.get_icon()) or "window-new-symbolic"})
            for c in node.get("nodes", []) + node.get("floating_nodes", []):
                walk(c, ws)
        walk(tree)
        self.windows = windows

    def opened(self):
        self._build()
        self.windows = []
        run(["swaymsg", "-t", "get_tree", "-r"], self._load_windows)
        self.search.set_text("")
        self.views.set_visible_child_name("pinned")
        GLib.idle_add(self.search.grab_focus)


CLIP_CACHE = os.path.join(GLib.get_user_cache_dir(), "quick-panel", "clipboard")
TERMINALS = {"foot", "footclient", "scratchpad", "kitty", "alacritty", "org.wezfurlong.wezterm"}


class ClipboardPage(Page):
    """Clipboard history (cliphist), like Windows' Win+V: pick an item to paste it."""
    title = "Clipboard"
    has_switch = False
    has_refresh = False
    has_status = False
    anchor = "center"
    width = 420

    def __init__(self, panel):
        super().__init__(panel)
        clear = Gtk.Button(label="Clear all")
        clear.add_css_class("flat")
        clear.connect("clicked", lambda *_: run(["cliphist", "wipe"], lambda *_: self.opened()))
        self.title_label.get_parent().append(clear)
        self.list.connect("row-activated", lambda _l, row: getattr(row, "qp_paste", lambda: None)())
        self.target = ""

    def opened(self):
        # Remember which window to paste into before our flyout takes the keyboard.
        run(["swaymsg", "-t", "get_tree", "-r"], self._got_focus)
        run(["cliphist", "list"], self._render)

    def _got_focus(self, ok, out):
        def find(node):
            if node.get("focused") and node.get("pid"):
                return node.get("app_id") or (node.get("window_properties") or {}).get("class") or ""
            for c in node.get("nodes", []) + node.get("floating_nodes", []):
                found = find(c)
                if found is not None:
                    return found
            return None
        try:
            self.target = find(json.loads(out)) or ""
        except ValueError:
            self.target = ""

    def _render(self, ok, out):
        self.list.clear()
        entries = [l.split("\t", 1) for l in out.splitlines() if "\t" in l][:30]
        if not entries:
            self.placeholder("Nothing copied yet. Copy something and it will show up here.")
            return
        os.makedirs(CLIP_CACHE, exist_ok=True)
        for cid, preview in entries:
            self.list.append(self._row(cid, preview))
        first = self.list.get_row_at_index(0)
        if first:
            GLib.idle_add(first.grab_focus)

    def _row(self, cid, preview):
        row = Gtk.ListBoxRow(activatable=True)
        box = Gtk.Box(spacing=8)
        m = re.match(r"\[\[ binary data .* (png|jpe?g|gif|webp|bmp) (\d+)x(\d+) \]\]", preview)
        if m:
            path = os.path.join(CLIP_CACHE, f"{cid}.{m.group(1)}")
            picture = Gtk.Picture(can_shrink=True, content_fit=Gtk.ContentFit.CONTAIN, hexpand=True,
                                  height_request=70, halign=Gtk.Align.START)
            if os.path.exists(path):
                picture.set_filename(path)
            else:
                run(["sh", "-c", 'cliphist decode "$1" > "$2"', "sh", cid, path],
                    lambda ok, _o, pic=picture, pth=path: ok and pic.set_filename(pth))
            box.append(picture)
        else:
            text = Gtk.Label(label=preview.strip(), xalign=0, hexpand=True, wrap=True, wrap_mode=2,
                             lines=3, ellipsize=3, max_width_chars=44)
            box.append(text)
        delete = Gtk.Button(icon_name="window-close-symbolic", tooltip_text="Remove", valign=Gtk.Align.START)
        delete.add_css_class("flat")
        delete.connect("clicked", lambda *_: run(["sh", "-c", 'printf "%s\\t%s\\n" "$1" "$2" | cliphist delete',
                                                  "sh", cid, preview], lambda *_: self.opened()))
        box.append(delete)
        row.set_child(box)
        row.add_css_class("qp-notif")
        row.set_margin_bottom(6)
        row.qp_paste = lambda: self._paste(cid)
        return row

    def _paste(self, cid):
        target = self.target
        self.panel.hide_panel()
        keys = "ctrl+shift+v" if target.lower() in TERMINALS else "ctrl+v"
        mods = ["-M", "ctrl"] + (["-M", "shift"] if "shift" in keys else [])
        # Copy, then paste into the window that had focus once our flyout has let go of the keyboard.
        script = ('cliphist decode "$1" | wl-copy && sleep 0.15 && wtype ' + " ".join(mods) +
                  ' -k v -m ctrl' + (" -m shift" if "shift" in keys else ""))
        spawn(["sh", "-c", script, "sh", cid])


WEATHER = os.path.expanduser("~/.local/bin/weather")


class WeatherPage(Page):
    """Current conditions, the next hours and a 7-day forecast (Open-Meteo via the weather script)."""
    title = "Weather"
    has_switch = False
    has_list = False
    has_refresh = False
    anchor = "left"

    def __init__(self, panel):
        super().__init__(panel)
        now = Gtk.Box(spacing=14, margin_top=4)
        self.now_icon = Gtk.Image(pixel_size=56)
        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
        self.now_temp = Gtk.Label(xalign=0)
        self.now_temp.add_css_class("qp-clock")
        self.now_desc = Gtk.Label(xalign=0)
        info.append(self.now_temp)
        info.append(self.now_desc)
        now.append(self.now_icon)
        now.append(info)
        self.details = Gtk.Label(xalign=0, wrap=True, max_width_chars=40)
        self.details.add_css_class("qp-sub")
        self.hours = Gtk.Box(spacing=4, homogeneous=True, margin_top=8)
        days_label = Gtk.Label(label="7-day forecast", xalign=0, margin_top=8)
        days_label.add_css_class("qp-section")
        self.days = Gtk.Grid(column_spacing=12, row_spacing=4)
        self.add_body(now, self.details, Gtk.Separator(margin_top=8), self.hours, Gtk.Separator(margin_top=8),
                      days_label, self.days)

    def opened(self):
        run([WEATHER, "json"], self._render)

    @staticmethod
    def _describe(code, is_day=1):
        table = {0: ("Clear", "weather-clear", "weather-clear-night"), 1: ("Mostly clear", "weather-few-clouds",
                 "weather-few-clouds-night"), 2: ("Partly cloudy", "weather-clouds", "weather-clouds-night"),
                 3: ("Cloudy", "weather-overcast", None), 45: ("Fog", "weather-fog", None),
                 48: ("Fog", "weather-fog", None)}
        if code in table:
            desc, icon, night = table[code]
        elif code in (51, 53, 61, 80):
            desc, icon, night = ("Light rain" if code != 80 else "Showers"), "weather-showers-scattered", None
        elif code in (55, 63, 65, 81, 82):
            desc, icon, night = "Rain", "weather-showers", None
        elif code in (56, 57, 66, 67):
            desc, icon, night = "Freezing rain", "weather-freezing-rain", None
        elif code in (71, 77, 85):
            desc, icon, night = "Light snow", "weather-snow-scattered", None
        elif code in (73, 75, 86):
            desc, icon, night = "Snow", "weather-snow", None
        elif code in (95, 96, 99):
            desc, icon, night = "Thunderstorm", "weather-storm", None
        else:
            desc, icon, night = "Unknown", "weather-none-available", None
        return desc, (night if night and not is_day else icon)

    def _render(self, ok, out):
        try:
            data = json.loads(out)
            cur = data["current"]
        except (ValueError, KeyError):
            self.status.set_label("Weather is unavailable right now.")
            return
        desc, icon = self._describe(cur["weather_code"], cur.get("is_day", 1))
        self.now_icon.set_from_icon_name(icon)
        self.now_temp.set_label(f"{round(cur['temperature_2m'])}°C")
        self.now_desc.set_label(desc)
        self.details.set_label(f"Feels like {round(cur['apparent_temperature'])}°  ·  "
                               f"Humidity {cur['relative_humidity_2m']}%  ·  Wind {round(cur['wind_speed_10m'])} km/h")
        updated = time.strftime("%H:%M", time.localtime(data.get("_fetched", time.time())))
        self.status.set_label(f"Updated {updated}" if DEMO else f"{data.get('_place', '')} · updated {updated}")

        while (c := self.hours.get_first_child()) is not None:
            self.hours.remove(c)
        h = data["hourly"]
        now_key = time.strftime("%Y-%m-%dT%H:00")
        start = next((i for i, t in enumerate(h["time"]) if t >= now_key), 0)
        for i in range(start + 1, min(start + 7, len(h["time"]))):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            t = Gtk.Label(label=h["time"][i][11:16])
            t.add_css_class("qp-stats")
            col.append(t)
            col.append(Gtk.Image(icon_name=self._describe(h["weather_code"][i], h["is_day"][i])[1], pixel_size=24))
            col.append(Gtk.Label(label=f"{round(h['temperature_2m'][i])}°"))
            rain = h.get("precipitation_probability", [None] * len(h["time"]))[i]
            r = Gtk.Label(label=f"{rain}%" if rain else " ")
            r.add_css_class("qp-stats")
            col.append(r)
            self.hours.append(col)

        while (c := self.days.get_first_child()) is not None:
            self.days.remove(c)
        d = data["daily"]
        for row, day in enumerate(d["time"]):
            name = "Today" if row == 0 else time.strftime("%a", time.strptime(day, "%Y-%m-%d"))
            ddesc, dicon = self._describe(d["weather_code"][row])
            cells = [Gtk.Label(label=name, xalign=0, width_chars=6),
                     Gtk.Image(icon_name=dicon, pixel_size=20, tooltip_text=ddesc),
                     Gtk.Label(label=ddesc, xalign=0, hexpand=True, ellipsize=3),
                     Gtk.Label(label=f"{d['precipitation_probability_max'][row] or 0}%", xalign=1),
                     Gtk.Label(label=f"{round(d['temperature_2m_max'][row])}° / {round(d['temperature_2m_min'][row])}°",
                               xalign=1)]
            cells[3].add_css_class("qp-stats")
            cells[2].add_css_class("qp-sub")
            for col, w in enumerate(cells):
                self.days.attach(w, col, row, 1, 1)


class SettingsPage(Page):
    title = "Settings"
    has_switch = False
    has_refresh = False
    has_status = False

    def __init__(self, panel):
        super().__init__(panel)
        nav = self.panel.navigate

        def external(cmd):
            return lambda: (self.panel.hide_panel(), spawn(cmd))

        for icon, title, sub, action in (
            ("network-wireless-symbolic", "Network & internet", "Wi-Fi and connections", lambda: nav("wifi")),
            ("bluetooth-active-symbolic", "Bluetooth & devices", "Pair and connect devices", lambda: nav("bluetooth")),
            ("audio-volume-high-symbolic", "Sound", "Volume and output device", lambda: nav("volume")),
            (NIGHT_ICON, "Night light", "Warmer colours in the evening", lambda: nav("night")),
            ("preferences-desktop-appearance-symbolic", "Light and dark mode", "Switch automatically at sunset",
             lambda: nav("appearance")),
            ("preferences-desktop-wallpaper-symbolic", "Personalization", "Change wallpaper and colours",
             self.pick_wallpaper),
            ("input-mouse-symbolic", "Mouse", "Buttons, DPI and lighting", external(["piper"])),
            ("preferences-system-network-symbolic", "Advanced network settings", "VPN, static IP, saved networks",
             external(["nm-connection-editor"])),
            ("computer-symbolic", "About this PC", "System information",
             external(["foot", "--hold", "fastfetch"])),
        ):
            row = make_row(title, icon, title, sub, Gtk.Box())
            row.qp_on_activate = action
            self.list.append(row)

    def pick_wallpaper(self):
        self.panel.hide_panel()
        images = Gtk.FileFilter(name="Images")
        images.add_mime_type("image/*")
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(images)
        dialog = Gtk.FileDialog(title="Choose a wallpaper", filters=filters, modal=True)
        pictures = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES)
        if pictures:
            dialog.set_initial_folder(Gio.File.new_for_path(pictures))

        def chosen(d, res):
            try:
                path = d.open_finish(res).get_path()
            except GLib.Error:
                return
            spawn(["notify-send", "-a", "Settings", "Applying wallpaper…", "Colours will update in a few seconds."])
            spawn([os.path.expanduser("~/.local/bin/wallpaper"), path])

        dialog.open(None, None, chosen)


class CalendarPage(Page):
    """Clock with seconds over a calendar. The clock ticks only while this page is open."""
    has_switch = False
    has_list = False
    has_refresh = False

    def __init__(self, panel):
        super().__init__(panel)
        self.timer = None
        self.title_label.add_css_class("qp-clock")
        self.calendar = Gtk.Calendar(margin_top=4)

        head = Gtk.Box(margin_top=8)
        label = Gtk.Label(label="Notifications", xalign=0, hexpand=True)
        label.add_css_class("qp-heading")
        self.clear = Gtk.Button(label="Clear all")
        self.clear.add_css_class("flat")
        self.clear.connect("clicked", lambda *_: self._clear_all())
        head.append(label)
        head.append(self.clear)
        self.notes = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        notes_scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, propagate_natural_height=True,
                                          max_content_height=220)
        notes_scroll.set_child(self.notes)
        self.shown = []
        self.add_body(head, notes_scroll, Gtk.Separator(margin_top=6), self.calendar)

    # Notifications: mako's history plus anything still on screen. mako has no
    # "clear history", so cleared ones are remembered by content and hidden.
    @staticmethod
    def _key(n):
        return f"{n.get('app_name')}|{n.get('summary')}|{n.get('body')}"

    def _cleared(self):
        try:
            with open(NOTIF_STATE) as f:
                return set(json.load(f))
        except (OSError, ValueError):
            return set()

    def _save_cleared(self, keys):
        os.makedirs(os.path.dirname(NOTIF_STATE), exist_ok=True)
        with open(NOTIF_STATE, "w") as f:
            json.dump(sorted(keys), f)

    def _load_notifications(self):
        run(["makoctl", "list", "-j"], lambda ok, live: run(["makoctl", "history", "-j"],
                                                            lambda ok2, hist: self._render_notes(live, hist)))

    def _render_notes(self, live, hist):
        notes = []
        for out in (live, hist):
            try:
                notes += json.loads(out or "[]")
            except ValueError:
                pass
        cleared = self._cleared()
        seen, visible = set(), []
        for n in sorted(notes, key=lambda n: -n.get("id", 0)):
            k = self._key(n)
            if k in seen or k in cleared:
                continue
            seen.add(k)
            visible.append(n)
        # Forget cleared entries mako no longer remembers, so the state file stays small.
        all_keys = {self._key(n) for n in notes}
        if cleared - all_keys:
            self._save_cleared(cleared & all_keys)
        self.shown = visible
        while (child := self.notes.get_first_child()) is not None:
            self.notes.remove(child)
        self.clear.set_visible(bool(visible))
        if not visible:
            none = Gtk.Label(label="No new notifications", xalign=0, margin_top=4, margin_bottom=4)
            none.add_css_class("qp-sub")
            self.notes.append(none)
            return
        for n in visible[:20]:
            self.notes.append(self._note_row(n))

    def _note_row(self, n):
        row = Gtk.Box(spacing=10)
        row.add_css_class("qp-notif")
        icon = n.get("app_icon") or ""
        if icon.startswith("/") and os.path.exists(icon):
            img = Gtk.Image.new_from_file(icon)
        else:
            img = Gtk.Image(icon_name=icon or n.get("desktop_entry") or "dialog-information-symbolic")
        img.set_pixel_size(28)
        img.set_valign(Gtk.Align.START)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
        app = Gtk.Label(label=n.get("app_name") or "", xalign=0, ellipsize=3)
        app.add_css_class("qp-stats")
        title = Gtk.Label(label=n.get("summary") or "", xalign=0, wrap=True, max_width_chars=30)
        title.add_css_class("qp-notif-title")
        text.append(app)
        text.append(title)
        if n.get("body"):
            body = Gtk.Label(label=n["body"], xalign=0, wrap=True, max_width_chars=30, lines=3, ellipsize=3)
            body.add_css_class("qp-sub")
            text.append(body)
        close = Gtk.Button(icon_name="window-close-symbolic", tooltip_text="Dismiss", valign=Gtk.Align.START)
        close.add_css_class("flat")
        close.connect("clicked", lambda *_: self._dismiss([n]))
        row.append(img)
        row.append(text)
        row.append(close)
        return row

    def _dismiss(self, notes):
        self._save_cleared(self._cleared() | {self._key(n) for n in notes})
        for n in notes:
            run(["makoctl", "dismiss", "-n", str(n.get("id", 0))])
        self._load_notifications()

    def _clear_all(self):
        self._dismiss(self.shown)
        run(["makoctl", "dismiss", "--all"])

    def opened(self):
        now = GLib.DateTime.new_now_local()
        (self.calendar.set_date if hasattr(self.calendar, "set_date") else self.calendar.select_day)(now)
        self._load_notifications()
        self._tick()

    def closed(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None

    def _tick(self):
        now = GLib.DateTime.new_now_local()
        self.title_label.set_label(now.format("%H:%M:%S"))
        self.status.set_label(now.format("%A, %B %-d, %Y"))
        # Wake at the start of the next second so the display never drifts.
        self.timer = GLib.timeout_add(1000 - now.get_microsecond() // 1000 + 2, self._tick)
        return False


AGENT_PATH = "/dev/litework/QuickPanel/agent"
AGENT_XML = """<node><interface name="org.bluez.Agent1">
  <method name="Release"/>
  <method name="RequestPinCode"><arg type="o" direction="in"/><arg type="s" direction="out"/></method>
  <method name="DisplayPinCode"><arg type="o" direction="in"/><arg type="s" direction="in"/></method>
  <method name="RequestPasskey"><arg type="o" direction="in"/><arg type="u" direction="out"/></method>
  <method name="DisplayPasskey"><arg type="o" direction="in"/><arg type="u" direction="in"/><arg type="q" direction="in"/></method>
  <method name="RequestConfirmation"><arg type="o" direction="in"/><arg type="u" direction="in"/></method>
  <method name="RequestAuthorization"><arg type="o" direction="in"/></method>
  <method name="AuthorizeService"><arg type="o" direction="in"/><arg type="s" direction="in"/></method>
  <method name="Cancel"/>
</interface></node>"""


class BluezAgent:
    """BlueZ pairing agent (replaces blueman-applet); prompts appear on the Bluetooth page."""

    def __init__(self, panel):
        self.panel = panel
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
        iface = Gio.DBusNodeInfo.new_for_xml(AGENT_XML).interfaces[0]
        self.bus.register_object_with_closures2(AGENT_PATH, iface, self._on_call, None, None)
        # (Re-)register whenever bluetoothd appears, e.g. after a restart.
        Gio.bus_watch_name_on_connection(self.bus, "org.bluez", Gio.BusNameWatcherFlags.NONE,
                                         lambda *_: self._register(), None)

    def _register(self):
        def default(conn, res):
            try:
                conn.call_finish(res)
            except GLib.Error as e:
                if "AlreadyExists" not in e.message:
                    print(f"quick-panel: could not register Bluetooth agent: {e.message}", file=sys.stderr)
            conn.call("org.bluez", "/org/bluez", "org.bluez.AgentManager1", "RequestDefaultAgent",
                      GLib.Variant("(o)", (AGENT_PATH,)), None, Gio.DBusCallFlags.NONE, -1, None, None)

        self.bus.call("org.bluez", "/org/bluez", "org.bluez.AgentManager1", "RegisterAgent",
                      GLib.Variant("(os)", (AGENT_PATH, "KeyboardDisplay")), None,
                      Gio.DBusCallFlags.NONE, -1, None, default)

    def _prop(self, path, name):
        try:
            v = self.bus.call_sync("org.bluez", path, "org.freedesktop.DBus.Properties", "Get",
                                   GLib.Variant("(ss)", ("org.bluez.Device1", name)), None,
                                   Gio.DBusCallFlags.NONE, 2000, None)
            return v.unpack()[0]
        except GLib.Error:
            return None

    def _on_call(self, _conn, _sender, _path, _iface, method, params, inv):
        page = self.panel.pages["bluetooth"]
        args = params.unpack()
        reject = lambda: inv.return_dbus_error("org.bluez.Error.Rejected", "Rejected")
        ok = lambda _text=None: inv.return_value(None)

        if method == "Release":
            return inv.return_value(None)
        if method == "Cancel":
            page.clear_prompt()
            return inv.return_value(None)

        name = self._prop(args[0], "Alias") or "the device"
        if method == "AuthorizeService" and self._prop(args[0], "Trusted"):
            return inv.return_value(None)

        self.panel.show("bluetooth")
        if method == "RequestConfirmation":
            page.show_prompt(f"Does {name} show the code {args[1]:06d}?", ok, reject, ok_label="Yes, pair")
        elif method == "RequestAuthorization":
            page.show_prompt(f"Pair with {name}?", ok, reject, ok_label="Pair")
        elif method == "AuthorizeService":
            page.show_prompt(f"Allow {name} to connect?", ok, reject, ok_label="Allow")
        elif method == "DisplayPinCode":
            page.show_prompt(f"Type {args[1]} on {name}, then press Enter.")
            inv.return_value(None)
        elif method == "DisplayPasskey":
            page.show_prompt(f"Type {args[1]:06d} on {name}, then press Enter.")
            inv.return_value(None)
        elif method == "RequestPinCode":
            page.show_prompt(f"Enter the PIN for {name}.",
                             lambda text: inv.return_value(GLib.Variant("(s)", (text or "",))),
                             reject, entry="PIN", ok_label="Pair")
        elif method == "RequestPasskey":
            def passkey(text):
                try:
                    inv.return_value(GLib.Variant("(u)", (int(text or ""),)))
                except ValueError:
                    reject()
            page.show_prompt(f"Enter the passkey shown on {name}.", passkey, reject, entry="Passkey",
                             ok_label="Pair")
        else:
            reject()


class QuickPanel(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.window = None
        self.backdrop = None
        self.current = None

    def do_startup(self):
        Adw.Application.do_startup(self)
        self.hold()  # stay resident while hidden

        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        colors = os.path.expanduser("~/.cache/wallust/colors-quickpanel.css")
        if os.path.exists(colors):
            p = Gtk.CssProvider()
            p.load_from_path(colors)
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), p,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)

        # Full-screen transparent layer behind the panel: clicking it closes the panel.
        self.backdrop = Gtk.Window(application=self, decorated=False)
        self.backdrop.set_css_classes(["qp-backdrop"])
        LayerShell.init_for_window(self.backdrop)
        LayerShell.set_namespace(self.backdrop, "quick-panel-backdrop")
        LayerShell.set_layer(self.backdrop, LayerShell.Layer.TOP)
        LayerShell.set_exclusive_zone(self.backdrop, -1)
        for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM, LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
            LayerShell.set_anchor(self.backdrop, edge, True)
        # GTK never draws a window with no content, and an undrawn surface gets no clicks,
        # so fill it with a practically invisible box.
        self.backdrop.set_child(Gtk.Box(hexpand=True, vexpand=True, css_classes=["qp-backdrop-fill"]))
        click = Gtk.GestureClick()
        click.connect("pressed", lambda *_: self.hide_panel())
        self.backdrop.add_controller(click)

        self.window = Gtk.Window(application=self, decorated=False)
        self.window.set_css_classes(["qp-window"])  # drop the default opaque background
        LayerShell.init_for_window(self.window)
        LayerShell.set_namespace(self.window, "quick-panel")
        LayerShell.set_layer(self.window, LayerShell.Layer.OVERLAY)
        LayerShell.set_keyboard_mode(self.window, LayerShell.KeyboardMode.EXCLUSIVE)
        LayerShell.set_anchor(self.window, LayerShell.Edge.BOTTOM, True)
        LayerShell.set_anchor(self.window, LayerShell.Edge.RIGHT, True)
        
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", lambda _c, kv, *_: (self.hide_panel(), True)[1] if kv == Gdk.KEY_Escape else False)
        self.window.add_controller(keys)

        self.root = None
        self.history = []
        self.stack = Gtk.Stack(hhomogeneous=False, vhomogeneous=False)
        self.stack.add_css_class("qp-panel")
        self.pages = {"wifi": WifiPage(self), "bluetooth": BluetoothPage(self),
                      "volume": VolumePage(self), "night": NightPage(self),
                      "control": ControlPage(self), "start": StartPage(self),
                      "settings": SettingsPage(self), "calendar": CalendarPage(self),
                      "appearance": AppearancePage(self), "clipboard": ClipboardPage(self),
                      "weather": WeatherPage(self)}
        for name, page in self.pages.items():
            self.stack.add_named(page, name)
        self.window.set_child(self.stack)

        self.agent = BluezAgent(self)
        self.osd = Osd(self)

        osd = Gio.SimpleAction.new("osd", GLib.VariantType.new("s"))
        osd.connect("activate", lambda _a, kind: self.osd.show(kind.get_string()))
        self.add_action(osd)

        # Open Start with a query already typed (scripts, testing).
        start_search = Gio.SimpleAction.new("start-search", GLib.VariantType.new("s"))
        start_search.connect("activate", lambda _a, q: (self.open_root("start"),
                                                        self.pages["start"].search.set_text(q.get_string())))
        self.add_action(start_search)

        toggle = Gio.SimpleAction.new("toggle", GLib.VariantType.new("s"))
        toggle.connect("activate", lambda _a, mode: self.toggle(mode.get_string()))
        self.add_action(toggle)
        # Open a detail page inside the visible panel (with back button); handy for scripts.
        navigate = Gio.SimpleAction.new("navigate", GLib.VariantType.new("s"))
        navigate.connect("activate", lambda _a, mode: self.window.get_visible() and mode.get_string() in self.pages
                         and self.navigate(mode.get_string()))
        self.add_action(navigate)

    def do_command_line(self, cmdline):
        args = cmdline.get_arguments()[1:]
        mode = args[0] if args else None
        if mode in self.pages:
            GLib.idle_add(self.toggle, mode)
        elif mode in ("--daemon", None):
            pass
        else:
            cmdline.printerr("usage: quick-panel-service [start|control|calendar|settings|appearance|wifi|bluetooth|volume|night|--daemon]\n")
            return 2
        return 0

    def toggle(self, mode):
        """Bar click: open `mode` as the root page, or close if it is already open."""
        if mode not in self.pages:
            return
        if self.window.get_visible() and self.root == mode:
            self.hide_panel()
        else:
            self.open_root(mode)

    def open_root(self, mode):
        if self.window.get_visible() and self.pages[self.root].anchor != self.pages[mode].anchor:
            self.hide_panel()   # re-map so the surface moves and resizes cleanly
        self.root = mode
        self.history = []
        self._show_page(mode)

    def navigate(self, mode):
        """Open a detail page from inside the panel, with a back button."""
        if self.current:
            self.history.append(self.current)
        self._show_page(mode)

    def go_back(self):
        if self.history:
            self._show_page(self.history.pop())

    def show(self, mode):
        if not (self.window.get_visible() and self.current == mode):
            self.open_root(mode)

    def _show_page(self, mode):
        if self.current and self.current != mode:
            self.pages[self.current].closed()
        self.current = mode
        page = self.pages[mode]
        page.set_back(bool(self.history))
        self.stack.set_visible_child_name(mode)
        page.opened()
        anchor = self.pages[self.root].anchor
        LayerShell.set_anchor(self.window, LayerShell.Edge.RIGHT, anchor == "right")
        LayerShell.set_anchor(self.window, LayerShell.Edge.LEFT, anchor == "left")
        for edge in (LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT, LayerShell.Edge.BOTTOM):
            LayerShell.set_margin(self.window, edge, 8)
        self.window.set_default_size(-1, -1)
        self.backdrop.present()
        self.window.present()

    def hide_panel(self):
        if self.current:
            self.pages[self.current].closed()
        self.current = None
        self.root = None
        self.history = []
        self.window.set_visible(False)
        self.backdrop.set_visible(False)


if __name__ == "__main__":
    Adw.init()
    # The shell always matches the dark taskbar; `appearance` only switches apps.
    Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
    sys.exit(QuickPanel().run(sys.argv))
