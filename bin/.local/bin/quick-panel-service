#!/usr/bin/env python3
"""quick-panel-service — Windows-style Wi-Fi and Bluetooth flyouts for waybar.

GTK4 + libadwaita on a layer-shell surface. Runs as a hidden background
service (started by sway); `quick-panel wifi|bluetooth` toggles a page
via the app's D-Bus "toggle" action.
Network is NetworkManager (nmcli), Bluetooth is BlueZ (bluetoothctl).
"""
import json
import os
import re
import sys
import time

# gtk4-layer-shell must be loaded before libwayland-client.
if "libgtk4-layer-shell" not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = "/usr/lib/libgtk4-layer-shell.so"
    os.execv(sys.executable, [sys.executable] + sys.argv)

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402
from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402

APP_ID = "dev.litework.QuickPanel"
WIDTH = 360
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]|\x01|\x02")

CSS = """
window.qp-window, window.qp-backdrop { background: none; box-shadow: none; }
.qp-panel {
  margin: 10px;
  background: alpha(@window_bg_color, 0.88);
  border-radius: 12px;
  border: 1px solid alpha(@window_fg_color, 0.10);
  box-shadow: 0 6px 18px alpha(black, 0.45);
  padding: 14px;
}
.qp-backdrop { background: transparent; }
.qp-title { font-weight: bold; font-size: 1.15em; }
.qp-status { opacity: 0.7; font-size: 0.9em; }
.qp-section { opacity: 0.6; font-size: 0.85em; font-weight: bold; margin-top: 6px; }
.qp-list { background: transparent; }
.qp-list > row { border-radius: 8px; padding: 6px 8px; margin: 1px 0; }
.qp-list > row:hover { background: alpha(@window_fg_color, 0.07); }
.qp-list > row.qp-active { background: alpha(@accent_bg_color, 0.22); }
