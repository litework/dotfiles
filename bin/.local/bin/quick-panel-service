def run(args, callback=None, stdin=None):
    """Run a command asynchronously; callback(ok, stdout) on completion."""
    flags = Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE
    if stdin is not None:
        flags |= Gio.SubprocessFlags.STDIN_PIPE
    try:
        proc = Gio.Subprocess.new(args, flags)
    except GLib.Error as e:
        if callback:
            callback(False, str(e))
        return None

    def done(p, res):
        try:
            _, out, _ = p.communicate_utf8_finish(res)
        except GLib.Error as e:
            out, ok = str(e), False
        else:
            ok = p.get_successful()
        if callback:
            callback(ok, ANSI.sub("", out or ""))

    proc.communicate_utf8_async(stdin, None, done)
    return proc


# Papirus ships a fixed-colour night-light icon that vanishes on tiles; use Adwaita's symbolic one.
NIGHT_ICON = "/usr/share/icons/Adwaita/symbolic/status/night-light-symbolic.svg"


def image(icon, size):
    """Gtk.Image from an icon name or an absolute path to a (symbolic) SVG."""
    if icon.startswith("/"):
        img = Gtk.Image.new_from_gicon(Gio.FileIcon.new(Gio.File.new_for_path(icon)))
    else:
        img = Gtk.Image(icon_name=icon)
    img.set_pixel_size(size)
    return img


def spawn(args):
    try:
        Gio.Subprocess.new(args, Gio.SubprocessFlags.NONE)
    except GLib.Error:
        pass


class ExpandableList(Gtk.ListBox):
    """ListBox where activating a row toggles a revealer with actions."""

    def __init__(self):
        super().__init__(selection_mode=Gtk.SelectionMode.NONE)
        self.add_css_class("qp-list")
        self.expanded_key = None
        self.connect("row-activated", self._on_activated)

    def _on_activated(self, _box, row):
        if getattr(row, "qp_on_activate", None):
            row.qp_on_activate()
            return
        key = getattr(row, "qp_key", None)
        self.expanded_key = None if self.expanded_key == key else key
        child = self.get_first_child()
        while child:
            if hasattr(child, "qp_revealer"):
                child.qp_revealer.set_reveal_child(child.qp_key == self.expanded_key)
            child = child.get_next_sibling()
        if self.expanded_key is not None and getattr(row, "qp_focus", None):
            GLib.idle_add(row.qp_focus.grab_focus)

    def clear(self):
        while (child := self.get_first_child()) is not None:
            self.remove(child)


def make_row(key, icon, title, subtitle, actions, active=False, trailing_icon=None, focus=None):
    row = Gtk.ListBoxRow(activatable=True)
    row.qp_key = key
    row.qp_focus = focus
    if active:
        row.add_css_class("qp-active")

    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    line = Gtk.Box(spacing=12)
    line.append(image(icon, 20))
    labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
    t = Gtk.Label(label=title, xalign=0, ellipsize=3)
    labels.append(t)
    if subtitle:
        s = Gtk.Label(label=subtitle, xalign=0, ellipsize=3)
        s.add_css_class("qp-sub")
        labels.append(s)
    line.append(labels)
    if trailing_icon:
        line.append(Gtk.Image(icon_name=trailing_icon, pixel_size=14, opacity=0.6))
    outer.append(line)

    revealer = Gtk.Revealer(transition_type=Gtk.RevealerTransitionType.SLIDE_DOWN)
    revealer.set_child(actions)
    outer.append(revealer)
    row.qp_revealer = revealer
    row.set_child(outer)
    return row


def action_box(*widgets):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=8)
    for w in widgets:
        box.append(w)
    return box


def button_row(*buttons):
    box = Gtk.Box(spacing=6, halign=Gtk.Align.END)
    for b in buttons:
        box.append(b)
    return box


def button(label, callback, suggested=False):
    b = Gtk.Button(label=label)
    if suggested:
        b.add_css_class("suggested-action")
    b.connect("clicked", lambda *_: callback())
    return b


class Page(Gtk.Box):
    title = ""
    settings_label = ""
    settings_cmd = None
    has_switch = True
    has_list = True
    has_refresh = True
    has_header = True
    has_status = True
    anchor = "right"    # "right" (above the status icons) or "center" (above Start)
    width = 340

    def __init__(self, panel):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.panel = panel
        self.set_size_request(self.width, -1)

        header = Gtk.Box(spacing=8)
        self.back_button = Gtk.Button(icon_name="go-previous-symbolic", tooltip_text="Back", visible=False)
        self.back_button.add_css_class("flat")
        self.back_button.connect("clicked", lambda *_: self.panel.go_back())
        self.title_label = Gtk.Label(label=self.title or "", xalign=0, hexpand=True)
        self.title_label.add_css_class("qp-title")
        self.switch = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.switch_handler = self.switch.connect("notify::active", self._on_switch)
        header.append(self.back_button)
        header.append(self.title_label)
        header.append(self.switch)
        header.set_visible(self.has_header)
        self.append(header)

        self.status = Gtk.Label(xalign=0)
        self.status.add_css_class("qp-status")
        self.status.set_visible(self.has_status)
        self.append(self.status)

        self.list = ExpandableList()
        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, propagate_natural_height=True,
                                      max_content_height=330)
        scroller.set_child(self.list)
        scroller.set_visible(self.has_list)
        self.scroller = scroller
        self.append(scroller)
        self.switch.set_visible(self.has_switch)

        footer = Gtk.Box(spacing=6)
        footer.add_css_class("qp-footer")
        footer.append(Gtk.Box(hexpand=True))
        if self.settings_cmd:
            settings = Gtk.Button(label=self.settings_label, halign=Gtk.Align.START)
            settings.add_css_class("flat")
            settings.connect("clicked", lambda *_: (self.panel.hide_panel(), spawn(self.settings_cmd)))
            footer.prepend(settings)
        self.refresh_button = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Refresh")
        self.refresh_button.add_css_class("flat")
        self.refresh_button.connect("clicked", lambda *_: self.rescan())
        footer.append(self.refresh_button)
        self.refresh_button.set_visible(self.has_refresh)
        footer.set_visible(bool(self.settings_cmd) or self.has_refresh)
        self.append(footer)

    def add_body(self, *widgets):
        """Insert widgets between the status line and the list."""
        anchor = self.status
        for w in widgets:
            self.insert_child_after(w, anchor)
            anchor = w

    def set_back(self, visible):
        self.back_button.set_visible(visible)

    def set_switch(self, active):
        self.switch.handler_block(self.switch_handler)
        self.switch.set_active(active)
        self.switch.handler_unblock(self.switch_handler)

    def section(self, text):
        row = Gtk.ListBoxRow(activatable=False, selectable=False)
        label = Gtk.Label(label=text, xalign=0)
        label.add_css_class("qp-section")
        row.set_child(label)
        self.list.append(row)

    def placeholder(self, text):
        row = Gtk.ListBoxRow(activatable=False)
        label = Gtk.Label(label=text, xalign=0, margin_top=6, margin_bottom=6)
        label.add_css_class("qp-sub")
        row.set_child(label)
        self.list.append(row)

    # Overridden by pages
    def _on_switch(self, *_):
        pass

    def opened(self):
        pass

    def closed(self):
        pass

    def rescan(self):
        pass


class WifiPage(Page):
    title = "Wi-Fi"
    settings_label = "More Wi-Fi settings"
    settings_cmd = ["nm-connection-editor"]

    def __init__(self, panel):
        super().__init__(panel)
        self.device = None
        self.busy = None        # SSID currently connecting
        self.error = {}         # SSID -> message
        self.timer = None

    def opened(self):
        self.list.expanded_key = None
        run(["nmcli", "-t", "-f", "DEVICE,TYPE", "device"], self._got_device)
        self.refresh(rescan=True)
        self.timer = GLib.timeout_add_seconds(8, lambda: (self.refresh(), True)[1])

    def closed(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None
        self.error.clear()

    def _got_device(self, ok, out):
        for line in out.splitlines():
            dev, _, typ = line.partition(":")
            if typ == "wifi":
                self.device = dev
                return

    def rescan(self):
        self.refresh(rescan=True)

    def refresh(self, rescan=False):
        def got_radio(ok, out):
            on = out.strip() == "enabled"
            self.set_switch(on)
            if not on:
                self.status.set_label("Wi-Fi is off")
                self.list.clear()
                return
            run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"], got_known)

        def got_known(ok, out):
            known = {l.rsplit(":", 1)[0].replace("\\:", ":") for l in out.splitlines()
                     if l.endswith(":802-11-wireless")}
            run(["nmcli", "--terse", "--escape", "no", "--fields", "IN-USE,SIGNAL,SECURITY,SSID",
                 "device", "wifi", "list", "--rescan", "yes" if rescan else "no"],
                lambda ok, out: self._render(out, known))

        run(["nmcli", "radio", "wifi"], got_radio)

    def _render(self, out, known):
        nets = {}
        for line in out.splitlines():
            parts = line.split(":", 3)
            if len(parts) < 4 or not parts[3]:
                continue
            inuse, signal, security, ssid = parts[0] == "*", int(parts[1] or 0), parts[2], parts[3]
            prev = nets.get(ssid)
            if prev is None or inuse or (not prev["inuse"] and signal > prev["signal"]):
                nets[ssid] = {"inuse": inuse or (prev or {}).get("inuse", False), "signal": signal,
                              "secure": security not in ("", "--"), "known": ssid in known}

        ordered = sorted(nets.items(), key=lambda kv: (not kv[1]["inuse"], -kv[1]["signal"]))
        connected = next((s for s, n in ordered if n["inuse"]), None)
        self.status.set_label(f"Connected to {connected}" if connected else "Not connected")

        expanded = self.list.expanded_key
        self.list.clear()
        if not ordered:
            self.placeholder("Searching for networks…")
        for ssid, n in ordered:
            self.list.append(self._row(ssid, n))
        self.list.expanded_key = expanded
        child = self.list.get_first_child()
        while child:
            if hasattr(child, "qp_revealer"):
                child.qp_revealer.set_reveal_child(child.qp_key == expanded)
            child = child.get_next_sibling()

    def _row(self, ssid, n):
        s = n["signal"]
        level = "excellent" if s >= 75 else "good" if s >= 50 else "ok" if s >= 25 else "weak"
        icon = f"network-wireless-signal-{level}-symbolic"
        if self.busy == ssid:
            sub = "Connecting…"
        elif n["inuse"]:
            sub = "Connected, secured" if n["secure"] else "Connected"
        else:
            sub = "Secured" if n["secure"] else "Open"
            if n["known"]:
                sub += " · Saved"

        widgets, focus = [], None
        if ssid in self.error:
            err = Gtk.Label(label=self.error[ssid], xalign=0, wrap=True)
            err.add_css_class("qp-error")
            widgets.append(err)
        if n["inuse"]:
            buttons = [button("Disconnect", self.disconnect)]
            if n["known"]:
                buttons.insert(0, button("Forget", lambda: self.forget(ssid)))
            widgets.append(button_row(*buttons))
        elif n["secure"] and not n["known"]:
            entry = Gtk.PasswordEntry(show_peek_icon=True, placeholder_text="Network security key")
            entry.connect("activate", lambda e: self.connect_to(ssid, e.get_text()))
            widgets.append(entry)
            widgets.append(button_row(button("Connect", lambda: self.connect_to(ssid, entry.get_text()), True)))
            focus = entry
        else:
            buttons = [button("Connect", lambda: self.connect_to(ssid), True)]
            if n["known"]:
                buttons.insert(0, button("Forget", lambda: self.forget(ssid)))
            widgets.append(button_row(*buttons))

        lock = "system-lock-screen-symbolic" if n["secure"] else None
        return make_row(ssid, icon, ssid, sub, action_box(*widgets), active=n["inuse"],
                        trailing_icon=lock, focus=focus)

    def connect_to(self, ssid, password=None):
        if password is not None and not password:
            return
        self.busy = ssid
        self.error.pop(ssid, None)
        self.refresh()
        args = ["nmcli", "--wait", "30", "device", "wifi", "connect", ssid]
        if password:
            args += ["password", password]

        def done(ok, out):
            self.busy = None
            if ok:
                self.list.expanded_key = None
            else:
                if password:
                    # Don't keep a profile with a wrong key.
                    run(["nmcli", "connection", "delete", "id", ssid])
                    self.error[ssid] = "Couldn't connect. Check the security key and try again."
                else:
                    self.error[ssid] = "Couldn't connect to this network."
            self.refresh()

        run(args, done)

    def disconnect(self):
        if self.device:
            run(["nmcli", "device", "disconnect", self.device], lambda *_: self.refresh())

    def forget(self, ssid):
        self.list.expanded_key = None
        run(["nmcli", "connection", "delete", "id", ssid], lambda *_: self.refresh())

    def _on_switch(self, *_):
        state = "on" if self.switch.get_active() else "off"
        run(["nmcli", "radio", "wifi", state], lambda *_: GLib.timeout_add(1500, lambda: self.refresh(True)))


BT_ICONS = {
    "audio-headset": "audio-headset-symbolic",
    "audio-headphones": "audio-headphones-symbolic",
    "audio-card": "audio-speakers-symbolic",
    "input-mouse": "input-mouse-symbolic",
    "input-keyboard": "input-keyboard-symbolic",
    "input-gaming": "input-gaming-symbolic",
    "phone": "phone-symbolic",
    "computer": "computer-symbolic",
}


class BluetoothPage(Page):
    title = "Bluetooth"

    def __init__(self, panel):
        super().__init__(panel)
        self.busy = {}          # mac -> "Connecting…" etc.
        self.error = {}
        self.scan_proc = None
        self.timer = None
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)

        # Pairing prompts from the agent show up here, under the status line.
        self.prompt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, visible=False)
        self.prompt.add_css_class("qp-prompt")
        self.insert_child_after(self.prompt, self.status)

    def show_prompt(self, text, on_ok=None, on_cancel=None, entry=None, ok_label="Confirm"):
        """Show a prompt; on_ok receives the entry text (or None)."""
        self.clear_prompt()
        label = Gtk.Label(label=text, xalign=0, wrap=True)
        label.add_css_class("qp-prompt-text")
        self.prompt.append(label)
        field = None
        if entry:
            field = Gtk.Entry(placeholder_text=entry, input_purpose=Gtk.InputPurpose.DIGITS)
            field.connect("activate", lambda e: (self.clear_prompt(), on_ok(e.get_text())))
            self.prompt.append(field)
        if on_ok:
            buttons = [button(ok_label, lambda: (self.clear_prompt(), on_ok(field.get_text() if field else None)), True)]
            if on_cancel:
                buttons.insert(0, button("Cancel", lambda: (self.clear_prompt(), on_cancel())))
            self.prompt.append(button_row(*buttons))
        self.prompt.set_visible(True)
        if field:
            GLib.idle_add(field.grab_focus)

    def clear_prompt(self):
        while (child := self.prompt.get_first_child()) is not None:
            self.prompt.remove(child)
        self.prompt.set_visible(False)

    def device_path(self, mac):
        try:
            objects = self.bus.call_sync("org.bluez", "/", "org.freedesktop.DBus.ObjectManager",
                                         "GetManagedObjects", None, None, Gio.DBusCallFlags.NONE, 3000, None)
        except GLib.Error:
            return None
        for path, ifaces in objects.unpack()[0].items():
            if ifaces.get("org.bluez.Device1", {}).get("Address") == mac:
                return path
        return None

    def opened(self):
        self.list.expanded_key = None
        self.refresh()
        self.timer = GLib.timeout_add_seconds(3, lambda: (self.refresh(), True)[1])

    def closed(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None
        self.stop_scan()
        self.error.clear()

    def rescan(self):
        self.stop_scan()
        self.start_scan()
        self.refresh()

    def start_scan(self):
        if self.scan_proc is None:
            self.scan_proc = run(["bluetoothctl", "--timeout", "20", "scan", "on"],
                                 lambda *_: setattr(self, "scan_proc", None))

    def stop_scan(self):
        if self.scan_proc is not None:
            self.scan_proc.force_exit()
            self.scan_proc = None
            run(["bluetoothctl", "scan", "off"])

    def refresh(self):
        def got_show(ok, out):
            powered = "Powered: yes" in out
            self.set_switch(powered)
            if not ok or "Controller" not in out:
                self.status.set_label("No Bluetooth adapter found")
                self.list.clear()
                return
            if not powered:
                self.status.set_label("Bluetooth is off")
                self.list.clear()
                return
            self.start_scan()
            # One shell round-trip: all devices, then `info` for each.
            script = ('bluetoothctl devices; echo "@@"; '
                      'for m in $(bluetoothctl devices | cut -d" " -f2); do echo "@@ $m"; bluetoothctl info "$m"; done')
            run(["sh", "-c", script], self._render)

        run(["bluetoothctl", "show"], got_show)

    def _render(self, ok, out):
        names, infos, current = {}, {}, None
        head, _, rest = out.partition("@@")
        for line in head.splitlines():
            m = re.match(r"Device ([0-9A-F:]{17}) (.+)", line.strip())
            if m:
                names[m.group(1)] = m.group(2)
        for line in rest.splitlines():
            line = line.strip()
            if line.startswith("@@ "):
                current = line[3:]
                infos[current] = {}
            elif current and ":" in line:
                k, _, v = line.partition(":")
                infos[current][k.strip()] = v.strip()

        devices = []
        for mac, name in names.items():
            info = infos.get(mac, {})
            if not info.get("Name") and re.fullmatch(r"[0-9A-F-]{17}", name):
                continue  # unnamed devices are noise
            battery = re.search(r"\((\d+)\)", info.get("Battery Percentage", ""))
            devices.append({
                "mac": mac, "name": info.get("Alias", name),
                "paired": info.get("Paired") == "yes", "connected": info.get("Connected") == "yes",
                "icon": BT_ICONS.get(info.get("Icon", ""), "bluetooth-active-symbolic"),
                "battery": battery.group(1) if battery else None,
            })

        connected = [d["name"] for d in devices if d["connected"]]
        self.status.set_label("Connected to " + ", ".join(connected) if connected else "Not connected")

        expanded = self.list.expanded_key
        self.list.clear()
        paired = sorted((d for d in devices if d["paired"]), key=lambda d: (not d["connected"], d["name"].lower()))
        found = sorted((d for d in devices if not d["paired"]), key=lambda d: d["name"].lower())
        if paired:
            self.section("Your devices")
            for d in paired:
                self.list.append(self._row(d))
        self.section("Add a device")
        if found:
            for d in found:
                self.list.append(self._row(d))
        else:
            self.placeholder("Searching… make sure your device is in pairing mode.")
        self.list.expanded_key = expanded
        child = self.list.get_first_child()
        while child:
            if hasattr(child, "qp_revealer"):
                child.qp_revealer.set_reveal_child(child.qp_key == expanded)
            child = child.get_next_sibling()

    def _row(self, d):
        mac = d["mac"]
        if mac in self.busy:
            sub = self.busy[mac]
        elif d["connected"]:
            sub = "Connected" + (f" · {d['battery']}% battery" if d["battery"] else "")
        elif d["paired"]:
            sub = "Paired"
        else:
            sub = "Available"

        widgets = []
        if mac in self.error:
            err = Gtk.Label(label=self.error[mac], xalign=0, wrap=True)
            err.add_css_class("qp-error")
            widgets.append(err)
        if d["connected"]:
            widgets.append(button_row(button("Remove", lambda: self.remove(mac)),
                                      button("Disconnect", lambda: self.act(mac, ["disconnect"], "Disconnecting…"))))
        elif d["paired"]:
            widgets.append(button_row(button("Remove", lambda: self.remove(mac)),
                                      button("Connect", lambda: self.act(mac, ["connect"], "Connecting…"), True)))
        else:
            widgets.append(button_row(button("Pair", lambda: self.pair(mac), True)))
        return make_row(mac, d["icon"], d["name"], sub, action_box(*widgets), active=d["connected"])

    def act(self, mac, args, label, then=None):
        self.busy[mac] = label
        self.error.pop(mac, None)
        self.refresh()

        def done(ok, out):
            self.busy.pop(mac, None)
            if not ok:
                self.error[mac] = "That didn't work. Make sure the device is on and nearby."
            elif then:
                then()
                return
            else:
                self.list.expanded_key = None
            self.refresh()

        run(["bluetoothctl", "--timeout", "25"] + args + [mac], done)

    def pair(self, mac):
        self.stop_scan()
        path = self.device_path(mac)
        if not path:
            self.error[mac] = "This device isn't available any more. Try refreshing."
            self.refresh()
            return
        self.busy[mac] = "Pairing…"
        self.error.pop(mac, None)
        self.refresh()

        def paired(conn, res):
            try:
                conn.call_finish(res)
            except GLib.Error:
                self.busy.pop(mac, None)
                self.clear_prompt()
                self.error[mac] = "Pairing failed. Make sure the device is in pairing mode and try again."
                self.refresh()
                return
            self.clear_prompt()
            run(["bluetoothctl", "trust", mac], lambda *_: self.act(mac, ["connect"], "Connecting…"))

        self.bus.call("org.bluez", path, "org.bluez.Device1", "Pair", None, None,
                      Gio.DBusCallFlags.NONE, 60000, None, paired)

    def remove(self, mac):
        self.list.expanded_key = None
        run(["bluetoothctl", "remove", mac], lambda *_: self.refresh())

    def _on_switch(self, *_):
        state = "on" if self.switch.get_active() else "off"
        run(["bluetoothctl", "power", state], lambda *_: self.refresh())


def slider_row(icon, scale, value_label, icon_widget=None):
    row = Gtk.Box(spacing=10, margin_top=6, margin_bottom=6)
    row.append(icon_widget or image(icon, 18))
    row.append(scale)
    row.append(value_label)
    return row


class ThrottledScale(Gtk.Box):
    """Icon + 0-100 slider + value; at most one write command in flight, ending on the latest value."""

    minimum = 0

    def __init__(self, icon_widget):
        super().__init__(spacing=10, margin_top=4, margin_bottom=4)
        self.target = None
        self.sending = False
        self.touched = 0.0      # last time the user moved the slider
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, self.minimum, 100, 1)
        self.scale.set_hexpand(True)
        self.scale.set_draw_value(False)
        self.handler = self.scale.connect("value-changed", self._on_scale)
        self.value_label = Gtk.Label(width_chars=4, xalign=1)
        self.append(icon_widget)
        self.append(self.scale)
        self.append(self.value_label)

    def show_value(self, value):
        if time.monotonic() - self.touched > 1.5:   # don't fight a drag in progress
            self.scale.handler_block(self.handler)
            self.scale.set_value(value)
            self.scale.handler_unblock(self.handler)
            self.value_label.set_label(f"{value}%")

    def _on_scale(self, scale):
        value = int(scale.get_value())
        self.touched = time.monotonic()
        self.value_label.set_label(f"{value}%")
        self.changed(value)
        self.target = value
        if not self.sending:
            self._send()

    def _send(self):
        self.sending = True
        value = self.target
        run(self.write_cmd(value), lambda *_: self._sent(value))

    def _sent(self, value):
        self.sending = False
        if self.target != value:
            self._send()

    def changed(self, value):
        pass


def refresh_bar_volume():
    """Tell waybar's volume icon (signal 11) to update now."""
    run(["pkill", "-RTMIN+11", "-x", "waybar"])


class VolumeSlider(ThrottledScale):
    def __init__(self):
        self.muted = False
        self.mute_button = Gtk.Button(icon_name="audio-volume-high-symbolic", tooltip_text="Mute")
        self.mute_button.add_css_class("flat")
        self.mute_button.connect("clicked", lambda *_: run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"],
                                                            lambda *_: (self.refresh(), refresh_bar_volume())))
        super().__init__(self.mute_button)

    def _icon(self, vol):
        if self.muted or vol == 0:
            return "audio-volume-muted-symbolic"
        return "audio-volume-low-symbolic" if vol < 34 else \
               "audio-volume-medium-symbolic" if vol < 67 else "audio-volume-high-symbolic"

    def refresh(self):
        def got(ok, out):
            m = re.search(r"Volume: ([\d.]+)( \[MUTED\])?", out)
            if not m:
                return
            vol, self.muted = round(float(m.group(1)) * 100), bool(m.group(2))
            self.show_value(vol)
            self.mute_button.set_icon_name(self._icon(int(self.scale.get_value())))
            self.mute_button.set_tooltip_text("Unmute" if self.muted else "Mute")
        run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], got)

    def changed(self, vol):
        if self.muted:
            self.muted = False
            run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0"])
        self.mute_button.set_icon_name(self._icon(vol))

    def write_cmd(self, vol):
        return ["sh", "-c", f"wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ {vol}% && pkill -RTMIN+11 -x waybar"]


class BrightnessSlider(ThrottledScale):
    minimum = 1   # never fully black

    def __init__(self):
        super().__init__(Gtk.Image(icon_name="display-brightness-symbolic", pixel_size=18, margin_start=8,
                                   margin_end=8))

    def refresh(self):
        def got(ok, out):
            m = re.search(r",(\d+)%,", out)
            if m:
                self.show_value(int(m.group(1)))
        run(["brightnessctl", "-m", "-c", "backlight"], got)

    def write_cmd(self, value):
        return ["brightnessctl", "-q", "-c", "backlight", "set", f"{value}%"]


class VolumePage(Page):
    title = "Sound"
    settings_label = "More sound settings"
    settings_cmd = ["pavucontrol"]
    has_switch = False
    has_refresh = False

    def __init__(self, panel):
        super().__init__(panel)
        self.timer = None
        self.slider = VolumeSlider()
        self.add_body(self.slider)

    def opened(self):
        self.refresh()
        self.timer = GLib.timeout_add(1000, lambda: (self.refresh(), True)[1])

    def closed(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None

    def refresh(self):
        self.slider.refresh()
        run(["pactl", "-f", "json", "list", "sinks"],
            lambda ok, sinks: run(["pactl", "get-default-sink"],
                                  lambda ok2, default: self._render_sinks(sinks, default.strip())))

    def _render_sinks(self, out, default):
        try:
            sinks = json.loads(out)
        except ValueError:
            return
        current = next((s.get("description", s["name"]) for s in sinks if s["name"] == default), None)
        self.status.set_label(f"Output: {current}" if current else "No output device")
        self.list.clear()
        self.scroller.set_visible(len(sinks) > 1)
        if len(sinks) < 2:
            return
        self.section("Output device")
        for sink in sinks:
            name = sink["name"]
            port = (sink.get("active_port") or "").lower()
            icon = "audio-headphones-symbolic" if "bluez" in name or "headphone" in port else "audio-speakers-symbolic"
            row = make_row(name, icon, sink.get("description", name), "In use" if name == default else None,
                           Gtk.Box(), active=name == default)
            row.qp_on_activate = lambda n=name: run(["pactl", "set-default-sink", n], lambda *_: self.refresh())
            self.list.append(row)


NIGHT_STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
                           "nightlight", "state")
NIGHTLIGHT = os.path.expanduser("~/.local/bin/nightlight")


class NightPage(Page):
    title = "Night light"
    has_list = False
    has_refresh = False

    def __init__(self, panel):
        super().__init__(panel)
        self.debounce = None

        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.scale.set_hexpand(True)
        self.scale.set_draw_value(False)
        self.scale_handler = self.scale.connect("value-changed", self._on_scale)
        self.value_label = Gtk.Label(width_chars=4, xalign=1)
        strength = Gtk.Label(label="Strength", xalign=0)
        strength.add_css_class("qp-section")

        schedule = Gtk.Box(spacing=8, margin_top=6)
        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
        labels.append(Gtk.Label(label="Follow the sun", xalign=0))
        sub = Gtk.Label(label="Fades in at sunset and out at sunrise" + ("" if DEMO else f" ({place_name()})"), xalign=0, wrap=True,
                        max_width_chars=30)
        sub.add_css_class("qp-sub")
        labels.append(sub)
        self.schedule_switch = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.schedule_handler = self.schedule_switch.connect("notify::active", self._on_schedule)
        schedule.append(labels)
        schedule.append(self.schedule_switch)

        self.add_body(strength, slider_row(NIGHT_ICON, self.scale, self.value_label), schedule)

    def _state(self):
        state = {"enabled": "1", "schedule": "1", "strength": "60"}
        try:
            with open(NIGHT_STATE) as f:
                for line in f:
                    k, _, v = line.strip().partition("=")
                    if k in state:
                        state[k] = v
        except OSError:
            pass
        return state

    def opened(self):
        st = self._state()
        self.set_switch(st["enabled"] == "1")
        for widget, handler, value in ((self.scale, self.scale_handler, int(st["strength"])),
                                       (self.schedule_switch, self.schedule_handler, st["schedule"] == "1")):
            widget.handler_block(handler)
            widget.set_value(value) if widget is self.scale else widget.set_active(value)
            widget.handler_unblock(handler)
        self.value_label.set_label(f"{int(st['strength'])}%")
        self._status(st)

    def _status(self, st):
        if st["enabled"] != "1":
            self.status.set_label("Off")
        elif st["schedule"] == "1":
            self.status.set_label("On from sunset to sunrise")
        else:
            self.status.set_label("On all the time")

    def _cmd(self, *args):
        run([NIGHTLIGHT, *args], lambda *_: self._status(self._state()))

    def _on_switch(self, *_):
        self._cmd("on" if self.switch.get_active() else "off")

    def _on_schedule(self, *_):
        self._cmd("schedule", "on" if self.schedule_switch.get_active() else "off")

    def _on_scale(self, scale):
        self.value_label.set_label(f"{int(scale.get_value())}%")
        # Restarting wlsunset on every tick would flicker; apply once the slider settles.
        if self.debounce:
            GLib.source_remove(self.debounce)
        self.debounce = GLib.timeout_add(250, self._apply_strength)

    def _apply_strength(self):
        self.debounce = None
        self._cmd("strength", str(int(self.scale.get_value())))
        return False


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


class Osd:
    """Volume/brightness pop-up above the taskbar, like Windows. Hides after 1.5 s."""

    def __init__(self, app):
        self.win = Gtk.Window(application=app, decorated=False)
        self.win.set_css_classes(["qp-window"])
        LayerShell.init_for_window(self.win)
        LayerShell.set_namespace(self.win, "quick-panel-osd")
        LayerShell.set_layer(self.win, LayerShell.Layer.OVERLAY)
        LayerShell.set_keyboard_mode(self.win, LayerShell.KeyboardMode.NONE)
        LayerShell.set_anchor(self.win, LayerShell.Edge.BOTTOM, True)
        LayerShell.set_margin(self.win, LayerShell.Edge.BOTTOM, 16)
        box = Gtk.Box(spacing=14)
        box.add_css_class("qp-osd")
        self.icon = Gtk.Image(pixel_size=20)
        self.bar = Gtk.LevelBar(min_value=0, max_value=100, valign=Gtk.Align.CENTER)
        self.bar.set_size_request(170, -1)
        for name in ("low", "high", "full"):
            self.bar.remove_offset_value(name)
        self.label = Gtk.Label(width_chars=3, xalign=1)
        box.append(self.icon)
        box.append(self.bar)
        box.append(self.label)
        self.win.set_child(box)
        self.hide_id = None

    def show(self, kind):
        if kind == "volume":
            def got(ok, out):
                m = re.search(r"Volume: ([\d.]+)( \[MUTED\])?", out)
                if m:
                    vol, muted = round(float(m.group(1)) * 100), bool(m.group(2))
                    icon = "audio-volume-muted-symbolic" if muted or vol == 0 else \
                        "audio-volume-low-symbolic" if vol < 34 else \
                        "audio-volume-medium-symbolic" if vol < 67 else "audio-volume-high-symbolic"
                    self._present(icon, 0 if muted else vol, "muted" if muted else str(vol))
            run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], got)
        elif kind == "brightness":
            def got(ok, out):
                m = re.search(r",(\d+)%,", out)
                if m:
                    self._present("display-brightness-symbolic", int(m.group(1)), m.group(1))
            run(["brightnessctl", "-m", "-c", "backlight"], got)

    def _present(self, icon, value, text):
        self.icon.set_from_icon_name(icon)
        self.bar.set_value(value)
        self.label.set_label(text)
        self.win.present()
        if self.hide_id:
            GLib.source_remove(self.hide_id)
        self.hide_id = GLib.timeout_add(1500, self._hide)

    def _hide(self):
        self.win.set_visible(False)
        self.hide_id = None
        return False


PLAYER_NAMES = {"spotify": "Spotify", "msedge": "Edge", "chromium": "Chromium", "mpv": "mpv", "mpd": "Music",
                "firefox": "Firefox"}
ART_CACHE = os.path.join(GLib.get_user_cache_dir(), "quick-panel", "art")


class MediaCard(Gtk.Box):
    """Now playing (any MPRIS player via playerctl) with previous / play-pause / next."""

    def __init__(self):
        super().__init__(spacing=10, visible=False)
        self.add_css_class("qp-media")
        self.player = None
        self.art_url = None
        self.art = Gtk.Image(pixel_size=48, icon_name="audio-x-generic")
        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
        self.title = Gtk.Label(xalign=0, ellipsize=3, max_width_chars=24)
        self.title.add_css_class("qp-media-title")
        self.artist = Gtk.Label(xalign=0, ellipsize=3, max_width_chars=24)
        self.source = Gtk.Label(xalign=0)
        self.source.add_css_class("qp-sub")
        self.source.add_css_class("qp-stats")
        for w in (self.title, self.artist, self.source):
            info.append(w)
        controls = Gtk.Box(spacing=2, valign=Gtk.Align.CENTER)
        self.play = Gtk.Button(icon_name="media-playback-start-symbolic", tooltip_text="Play/pause")
        for icon, cmd, tip in (("media-skip-backward-symbolic", "previous", "Previous"), (None, "play-pause", None),
                               ("media-skip-forward-symbolic", "next", "Next")):
            b = self.play if icon is None else Gtk.Button(icon_name=icon, tooltip_text=tip)
            b.add_css_class("flat")
            b.connect("clicked", lambda _b, c=cmd: self.player and run(["playerctl", "-p", self.player, c],
                                                                       lambda *_: self.refresh()))
            controls.append(b)
        self.append(self.art)
        self.append(info)
        self.append(controls)

    def refresh(self):
        fmt = "{{playerName}}\t{{status}}\t{{title}}\t{{artist}}\t{{mpris:artUrl}}"
        run(["playerctl", "-a", "metadata", "--format", fmt], self._got)

    def _got(self, ok, out):
        players = [l.split("\t") for l in out.splitlines() if l.count("\t") == 4]
        players = [p for p in players if p[2] or p[3]]
        if not ok or not players:
            self.set_visible(False)
            return
        current = next((p for p in players if p[1] == "Playing"), None) or \
            next((p for p in players if p[0] == self.player), players[0])
        name, status, title, artist, art = current
        self.player = name
        self.title.set_label(title or "Unknown title")
        self.artist.set_label(artist)
        self.artist.set_visible(bool(artist))
        self.source.set_label(PLAYER_NAMES.get(name.split(".")[0], name.split(".")[0].capitalize()))
        self.play.set_icon_name("media-playback-pause-symbolic" if status == "Playing"
                                else "media-playback-start-symbolic")
        self._set_art(art)
        self.set_visible(True)

    def _set_art(self, url):
        if url == self.art_url:
            return
        self.art_url = url
        if url.startswith("file://"):
            self.art.set_from_file(GLib.filename_from_uri(url)[0])
        elif url.startswith("http"):
            os.makedirs(ART_CACHE, exist_ok=True)
            path = os.path.join(ART_CACHE, GLib.compute_checksum_for_string(GLib.ChecksumType.SHA1, url, -1))
            if os.path.exists(path):
                self.art.set_from_file(path)
            else:
                self.art.set_from_icon_name("audio-x-generic")
                run(["curl", "-sfL", "--max-time", "10", "-o", path, url],
                    lambda ok, _o, u=url, pth=path: ok and self.art_url == u and self.art.set_from_file(pth))
        else:
            self.art.set_from_icon_name("audio-x-generic")


NOTIF_STATE = os.path.join(GLib.get_user_state_dir(), "quick-panel", "notifications-cleared.json")


class Tile(Gtk.Box):
    """Windows-style quick setting: toggle button (+ optional arrow to a detail page) and a label."""

    def __init__(self, icon, label, on_toggle, on_more=None):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.active = False
        self.label_text = label
        self.buttons = Gtk.Box()
        self.buttons.add_css_class("linked")
        toggle = Gtk.Button(hexpand=True, child=image(icon, 18))
        toggle.add_css_class("qp-tile-button")
        toggle.connect("clicked", lambda *_: on_toggle(not self.active))
        self.buttons.append(toggle)
        if on_more:
            more = Gtk.Button(icon_name="go-next-symbolic", tooltip_text="More")
            more.add_css_class("qp-tile-button")
            more.connect("clicked", lambda *_: on_more())
            self.buttons.append(more)
        self.label = Gtk.Label(label=label, ellipsize=3, max_width_chars=12)
        self.label.add_css_class("qp-tile-label")
        self.append(self.buttons)
        self.append(self.label)

    def set_state(self, active, label=None):
        self.active = active
        child = self.buttons.get_first_child()
        while child:
            (child.add_css_class if active else child.remove_css_class)("qp-on")
            child = child.get_next_sibling()
        self.label.set_label(label or self.label_text)


APPEARANCE = os.path.expanduser("~/.local/bin/appearance")


class AppearancePage(Page):
    """Light/dark mode for apps; the taskbar and flyouts stay dark."""
    title = "Appearance"
    has_switch = False
    has_list = False
    has_refresh = False

    def __init__(self, panel):
        super().__init__(panel)
        self.mode = "auto"

        modes = Gtk.Box(homogeneous=True, margin_top=6)
        modes.add_css_class("linked")
        self.light = Gtk.ToggleButton(label="Light")
        self.dark = Gtk.ToggleButton(label="Dark", group=self.light)
        self.light_handler = self.light.connect("toggled", lambda b: b.get_active() and self._set("light"))
        self.dark_handler = self.dark.connect("toggled", lambda b: b.get_active() and self._set("dark"))
        modes.append(self.light)
        modes.append(self.dark)

        schedule = Gtk.Box(spacing=8, margin_top=8)
        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
        labels.append(Gtk.Label(label="Follow the sun", xalign=0))
        self.sun_label = Gtk.Label(xalign=0, wrap=True, max_width_chars=30)
        self.sun_label.add_css_class("qp-sub")
        labels.append(self.sun_label)
        self.auto = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.auto_handler = self.auto.connect("notify::active", self._on_auto)
        schedule.append(labels)
        schedule.append(self.auto)

        note = Gtk.Label(label="Apps switch between light and dark. The taskbar, menus and terminal stay dark.",
                         xalign=0, wrap=True, margin_top=6, max_width_chars=36)
        note.add_css_class("qp-sub")
        self.add_body(modes, schedule, note)

    def opened(self):
        run([APPEARANCE, "sun"], lambda ok, out: self.sun_label.set_label(
            "Light from sunrise to sunset" + ("" if DEMO else f" in {place_name()}") + " (today "
            + out.strip().replace("sunrise ", "").replace(", sunset ", "–") + ")"))
        self.refresh()

    def refresh(self):
        run([APPEARANCE], self._got)

    def _got(self, ok, out):
        self.mode = out.strip()
        dark = self.mode.endswith("dark")
        auto = self.mode.startswith("auto")
        for button, handler, active in ((self.light, self.light_handler, not dark), (self.dark, self.dark_handler, dark)):
            button.handler_block(handler)
            button.set_active(active)
            button.handler_unblock(handler)
        self.auto.handler_block(self.auto_handler)
        self.auto.set_active(auto)
        self.auto.handler_unblock(self.auto_handler)
        self.status.set_label(("Dark" if dark else "Light") + (" · follows the sun" if auto else ""))

    def _set(self, mode):
        run([APPEARANCE, mode], lambda *_: self.refresh())

    def _on_auto(self, *_):
        self._set("auto" if self.auto.get_active() else ("dark" if self.mode.endswith("dark") else "light"))


class ControlPage(Page):
    """Quick settings: tiles, brightness and volume, battery and system stats."""
    has_header = False
    has_status = False
    has_switch = False
    has_list = False
    has_refresh = False

    def __init__(self, panel):
        super().__init__(panel)
        self.timer = None
        self.cpu_prev = None
        nav = self.panel.navigate

        self.wifi = Tile("network-wireless-symbolic", "Wi-Fi",
                         lambda on: run(["nmcli", "radio", "wifi", "on" if on else "off"], lambda *_: self.refresh()),
                         lambda: nav("wifi"))
        self.bt = Tile("bluetooth-active-symbolic", "Bluetooth",
                       lambda on: run(["bluetoothctl", "power", "on" if on else "off"], lambda *_: self.refresh()),
                       lambda: nav("bluetooth"))
        self.night = Tile(NIGHT_ICON, "Night light",
                          lambda on: run([NIGHTLIGHT, "on" if on else "off"], lambda *_: self.refresh()),
                          lambda: nav("night"))
        self.dnd = Tile("notifications-disabled-symbolic", "Do not disturb",
                        lambda on: run(["makoctl", "mode", "-a" if on else "-r", "do-not-disturb"],
                                       lambda *_: self.refresh()))
        grid = Gtk.Grid(column_spacing=8, row_spacing=10, column_homogeneous=True, margin_bottom=6)
        grid.attach(self.wifi, 0, 0, 1, 1)
        grid.attach(self.bt, 1, 0, 1, 1)
        grid.attach(self.night, 2, 0, 1, 1)
        grid.attach(self.dnd, 1, 1, 1, 1)
        self.theme = Tile("preferences-desktop-appearance-symbolic", "Dark mode",
                          lambda on: run([APPEARANCE, "dark" if on else "light"], lambda *_: self.refresh()),
                          lambda: nav("appearance"))
        grid.attach(self.theme, 0, 1, 1, 1)

        self.brightness = BrightnessSlider()
        self.volume = VolumeSlider()
        more = Gtk.Button(icon_name="go-next-symbolic", tooltip_text="Output devices")
        more.add_css_class("flat")
        more.connect("clicked", lambda *_: nav("volume"))
        self.volume.append(more)

        footer = Gtk.Box(spacing=8, margin_top=4)
        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
        self.battery_label = Gtk.Label(xalign=0)
        self.stats_label = Gtk.Label(xalign=0)
        self.stats_label.add_css_class("qp-stats")
        info.append(self.battery_label)
        info.append(self.stats_label)
        gear = Gtk.Button(icon_name="emblem-system-symbolic", tooltip_text="Settings", valign=Gtk.Align.CENTER)
        gear.add_css_class("flat")
        gear.connect("clicked", lambda *_: nav("settings"))
        footer.append(info)
        footer.append(gear)

        self.media = MediaCard()
        self.add_body(self.media, grid, self.brightness, self.volume, Gtk.Separator(margin_top=4), footer)

    def opened(self):
        self.refresh()
        self.timer = GLib.timeout_add(2000, lambda: (self.refresh(), True)[1])

    def closed(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None

    def refresh(self):
        def wifi(ok, radio):
            if radio.strip() != "enabled":
                return self.wifi.set_state(False)
            run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active"],
                lambda ok, out: self.wifi.set_state(True, "Wi-Fi" if DEMO else next(
                    (l.rsplit(":", 1)[0].replace("\\:", ":") for l in out.splitlines()
                     if l.endswith(":802-11-wireless")), "Wi-Fi")))
        run(["nmcli", "radio", "wifi"], wifi)

        def bt(ok, show):
            if "Powered: yes" not in show:
                return self.bt.set_state(False)
            run(["bluetoothctl", "devices", "Connected"],
                lambda ok, out: self.bt.set_state(True, next(
                    (l.split(" ", 2)[2] for l in out.splitlines() if l.startswith("Device ")), "Bluetooth")))
        run(["bluetoothctl", "show"], bt)

        state = dict(l.partition("=")[::2] for l in read(NIGHT_STATE).splitlines() if "=" in l)
        self.night.set_state(state.get("enabled", "1") == "1")
        run(["makoctl", "mode"], lambda ok, out: self.dnd.set_state("do-not-disturb" in out.split()))
        run([APPEARANCE], lambda ok, out: self.theme.set_state(
            out.strip().endswith("dark"), ("Dark" if out.strip().endswith("dark") else "Light") + " mode"))

        self.brightness.refresh()
        self.volume.refresh()
        self.media.refresh()

        bat = "/sys/class/power_supply/BAT0"
        text = f"Battery {read(bat + '/capacity', '?')}%"
        status = read(bat + "/status")
        if status in ("Charging", "Full", "Not charging"):
            text += " · plugged in" if status != "Charging" else " · charging"
        for dev in sorted(os.listdir("/sys/class/power_supply")):
            if dev.startswith("hidpp_battery"):
                text += f"   Mouse {read(f'/sys/class/power_supply/{dev}/capacity', '?')}%"
                break
        self.battery_label.set_label(text)

        fields = [int(x) for x in read("/proc/stat").splitlines()[0].split()[1:]]
        idle, total = fields[3] + fields[4], sum(fields)
        cpu = 0
        if self.cpu_prev:
            d_total, d_idle = total - self.cpu_prev[1], idle - self.cpu_prev[0]
            cpu = round(100 * (d_total - d_idle) / d_total) if d_total else 0
        self.cpu_prev = (idle, total)
        mem = {l.split(":")[0]: int(l.split()[1]) for l in read("/proc/meminfo").splitlines()[:5]}
        ram = round(100 * (1 - mem["MemAvailable"] / mem["MemTotal"]))
        self.stats_label.set_label(f"CPU {cpu}%  ·  RAM {ram}%")


PINNED_FILE = os.path.expanduser("~/.config/quick-panel/pinned")


_OPS = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul, ast.Div: operator.truediv,
        ast.FloorDiv: operator.floordiv, ast.Mod: operator.mod, ast.Pow: operator.pow,
        ast.USub: operator.neg, ast.UAdd: operator.pos}
_FUNCS = {"sqrt": math.sqrt, "sin": math.sin, "cos": math.cos, "tan": math.tan, "log": math.log10,
          "ln": math.log, "abs": abs, "round": round}
_CONSTS = {"pi": math.pi, "e": math.e}


def calculate(text):
    """Evaluate simple arithmetic safely; returns a display string or None if it isn't a sum."""
    expr = text.strip().lstrip("=").replace("^", "**").replace("×", "*").replace("÷", "/").replace(",", "")
    if not expr or not any(ch.isdigit() for ch in expr):
        return None
    if not text.strip().startswith("=") and not any(op in expr for op in "+-*/%(") :
        return None

    def ev(node):
        if isinstance(node, ast.Expression):
            return ev(node.body)
        if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
            return node.value
        if isinstance(node, ast.BinOp) and type(node.op) in _OPS:
            left, right = ev(node.left), ev(node.right)
            if isinstance(node.op, ast.Pow) and abs(right) > 1000:
                raise ValueError("exponent too large")
            return _OPS[type(node.op)](left, right)
        if isinstance(node, ast.UnaryOp) and type(node.op) in _OPS:
            return _OPS[type(node.op)](ev(node.operand))
        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id in _FUNCS:
            return _FUNCS[node.func.id](*[ev(a) for a in node.args])
        if isinstance(node, ast.Name) and node.id in _CONSTS:
            return _CONSTS[node.id]
        raise ValueError("unsupported")

    try:
        value = ev(ast.parse(expr, mode="eval"))
    except Exception:
        return None
    if isinstance(value, float):
        if value.is_integer() and abs(value) < 1e15:
            value = int(value)
        else:
            value = float(f"{value:.10g}")
    return f"{value:,}" if isinstance(value, int) and abs(value) >= 10000 else str(value)


LOCK_CMD = [os.path.expanduser("~/.local/bin/lock")]
