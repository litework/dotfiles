#!/bin/sh
# lock — lock the screen with gtklock, supervised: if gtklock fails to start or dies while
# the session is locked, swaylock takes over the lock (sway allows a new lock client after a
# crash), so you get a password prompt instead of sway's red "lock client died" screen.
pgrep -x gtklock >/dev/null || pgrep -x swaylock >/dev/null && exit 0
setsid -f sh -c '
    gtklock
    [ $? -ne 0 ] && exec swaylock -f -C "$HOME/.cache/wallust/swaylock"
' >/dev/null 2>&1
# Give the lock a moment to engage (swayidle before-sleep waits for this script).
sleep 1
