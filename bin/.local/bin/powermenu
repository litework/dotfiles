#!/bin/sh
# powermenu — lock/logout/suspend/reboot/shutdown via fuzzel.
choice="$(printf 'Lock\nLogout\nSuspend\nReboot\nShutdown\n' | fuzzel --dmenu --prompt 'power> ' --lines 5)" || exit 0

case "$choice" in
    Lock)     swaylock -f -C "$HOME/.cache/wallust/swaylock" ;;
    Logout)   swaymsg exit ;;
    Suspend)  systemctl suspend ;;
    Reboot)   systemctl reboot ;;
    Shutdown) systemctl poweroff ;;
esac
