#!/bin/sh
# quick-panel wifi|bluetooth — toggle the flyout. Talks to the resident
# quick-panel-service over D-Bus (instant); starts the service if needed.
mode="${1:?usage: quick-panel wifi|bluetooth}"
gdbus call --session --dest dev.litework.QuickPanel --object-path /dev/litework/QuickPanel \
    --method org.gtk.Actions.Activate toggle "[<'$mode'>]" "{}" >/dev/null 2>&1 ||
    exec "$HOME/.local/bin/quick-panel-service" "$mode"
