#!/bin/sh
# screenshot [area|full] — save to ~/Pictures/Screenshots and copy to the clipboard.
set -eu

dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"

case "${1:-area}" in
    area) grim -g "$(slurp)" "$file" ;;
    full) grim "$file" ;;
    *) echo "usage: screenshot [area|full]" >&2; exit 1 ;;
esac

wl-copy < "$file"
notify-send -i "$file" "Screenshot" "Saved and copied: ${file##*/}"
