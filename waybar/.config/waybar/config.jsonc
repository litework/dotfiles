// ~/.config/waybar/config.jsonc — Windows 11-style taskbar.
// Workspaces left; Start + open windows centred; tray, status icons and clock right.
// Start, the status icons and the clock open quick-panel flyouts.
{
  "position": "bottom",
  "height": 32,
  "spacing": 2,
  "modules-left": ["custom/weather", "sway/workspaces", "sway/mode"],
  "modules-center": ["custom/start", "wlr/taskbar"],
  "modules-right": ["tray", "group/status", "clock"],

  "sway/workspaces": { "disable-scroll": true },

  "custom/weather": {
    "exec": "~/.local/bin/weather bar",
    "return-type": "json",
    "interval": 900,
    "on-click": "~/.local/bin/quick-panel weather"
  },

  "custom/start": {
    "format": "\uf303",
    "tooltip": false,
    "on-click": "~/.local/bin/quick-panel start"
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 20,
    "icon-theme": "Papirus-Dark",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["scratchpad"]
  },

  "tray": { "spacing": 8, "icon-size": 16 },

  // Papirus panel icons: bar-icon prints a state class, papirus.css maps it to an icon.
  "group/status": {
    "orientation": "horizontal",
    "modules": ["custom/network", "custom/volume", "custom/battery"]
  },
  "custom/network": {
    "exec": "~/.local/bin/bar-icon network",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.local/bin/quick-panel control"
  },
  "custom/volume": {
    "exec": "~/.local/bin/bar-icon volume",
    "return-type": "json",
    "interval": 5,
    "signal": 11,
    "on-click": "~/.local/bin/quick-panel control",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && pkill -RTMIN+11 -x waybar",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ && pkill -RTMIN+11 -x waybar",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && pkill -RTMIN+11 -x waybar"
  },
  "custom/battery": {
    "exec": "~/.local/bin/bar-icon battery",
    "return-type": "json",
    "interval": 30,
    "on-click": "~/.local/bin/quick-panel control"
  },

  "clock": {
    "format": "{:%H:%M\n%Y-%m-%d}",
    "justify": "center",
    "tooltip": false,
    "on-click": "~/.local/bin/quick-panel calendar"
  }
}
