// ~/.config/waybar/config.jsonc — Windows 11-style taskbar.
// Workspaces left; Start + open windows centred; tray, status icons and clock right.
// Start, the status icons and the clock open quick-panel flyouts.
{
  "position": "bottom",
  "height": 32,
  "spacing": 2,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["custom/start", "wlr/taskbar"],
  "modules-right": ["tray", "group/status", "clock"],

  "sway/workspaces": { "disable-scroll": true },

  "custom/start": {
    "format": "\uf303",
    "tooltip": false,
    "on-click": "~/.local/bin/quick-panel start"
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 20,
    "icon-theme": "Papirus-Dark",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["scratchpad"]
  },

  "tray": { "spacing": 8, "icon-size": 16 },

  "group/status": {
    "orientation": "horizontal",
    "modules": ["network", "wireplumber", "battery"]
  },
  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "format-disabled": "󰤮",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-disconnected": "Not connected",
    "on-click": "~/.local/bin/quick-panel control"
  },
  "wireplumber": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "scroll-step": 5,
    "tooltip-format": "Volume {volume}%",
    "on-click": "~/.local/bin/quick-panel control",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "battery": {
    "bat": "BAT0",
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "󰚥",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "Battery {capacity}%",
    "on-click": "~/.local/bin/quick-panel control"
  },

  "clock": {
    "format": "{:%H:%M\n%Y-%m-%d}",
    "justify": "center",
    "tooltip": false,
    "on-click": "~/.local/bin/quick-panel calendar"
  }
}
