// ~/.config/waybar/config.jsonc — replaces polybar (same module layout)
{
  "position": "bottom",
  "height": 22,
  "spacing": 4,
  "modules-left": ["custom/power", "sway/workspaces", "sway/mode", "mpd"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "wireplumber", "custom/brightness", "custom/night", "battery", "custom/mouse", "tray", "network", "bluetooth"],

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.local/bin/powermenu"
  },
  "sway/workspaces": { "disable-scroll": true },
  "mpd": {
    "format": "{stateIcon} {artist} - {title}",
    "format-stopped": "",
    "format-disconnected": "",
    "state-icons": { "playing": "", "paused": "" },
    "max-length": 40,
    "on-click": "mpc toggle"
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "cpu": { "format": "CPU {usage}%", "interval": 5 },
  "memory": { "format": "RAM {percentage}%", "interval": 10, "tooltip-format": "{used:0.1f} / {total:0.1f} GiB used" },
  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱 {device_alias}",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "~/.local/bin/quick-panel bluetooth"
  },
  "wireplumber": {
    "format": "VOL {volume}%",
    "format-muted": "VOL muted",
    "tooltip-format": "{node_name}",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },
  "custom/mouse": {
    "exec": "~/.local/bin/mouse-battery",
    "format": "MOUSE {}",
    "interval": 60,
    "tooltip": false,
    "on-click": "piper"
  },
  "custom/night": {
    "exec": "~/.local/bin/nightlight status",
    "format": "NIGHT {}",
    "interval": 300,
    "signal": 9,
    "tooltip": false,
    "on-click": "~/.local/bin/nightlight toggle"
  },
  "custom/brightness": {
    "exec": "brightnessctl -m -c backlight | cut -d, -f4",
    "format": "BRI {}",
    "interval": 30,
    "signal": 8,
    "tooltip": false,
    "on-scroll-up": "brightnessctl -q set 5%+ && pkill -RTMIN+8 -x waybar",
    "on-scroll-down": "brightnessctl -q set 5%- && pkill -RTMIN+8 -x waybar"
  },
  "network": {
    "format-wifi": "{icon} {essid}",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": "󰖪 offline",
    "format-disabled": "󰖪 off",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr} on {ifname}",
    "on-click": "~/.local/bin/quick-panel wifi",
    "on-click-right": "nm-connection-editor"
  },
  "battery": {
    "bat": "BAT0",
    "states": { "warning": 25, "critical": 10 },
    "format": "BAT {capacity}%",
    "format-charging": "BAT {capacity}% 󱐋",
    "format-plugged": "BAT {capacity}% 󰚥",
    "tooltip-format": "{timeTo}"
  },
  "tray": { "spacing": 6 }
}
