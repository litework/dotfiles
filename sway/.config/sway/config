# ~/.config/sway/config
# Ported from bspwm + sxhkd. Keys follow the old layout where sway has an equivalent.

set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term footclient
set $menu fuzzel

# Colors generated by wallust from the current wallpaper (see `wallpaper`).
include ~/.cache/wallust/colors-sway

### Look
font pango:Pragmata Pro Mono 10
default_border pixel 1
default_floating_border pixel 1
gaps inner 11
smart_borders on
focus_follows_mouse no
mouse_warping none

#                       border     background text       indicator  child_border
client.focused          $color7    $color7    $color0    $color7    $color7
client.focused_inactive $color8    $color8    $color15   $color8    $color8
client.unfocused        $color8    $color0    $color7    $color8    $color8
client.urgent           $color1    $color1    $color0    $color1    $color1

### Theme
# Dark GTK/libadwaita apps (Qt 6 follows color-scheme via the portal).
seat seat0 xcursor_theme capitaine-cursors 24
exec_always {
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
    gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
    gsettings set org.gnome.desktop.interface cursor-theme 'capitaine-cursors'
    gsettings set org.gnome.desktop.interface cursor-size 24
    gsettings set org.gnome.desktop.interface monospace-font-name 'Pragmata Pro Mono 11'
}

### Input
input type:keyboard {
    xkb_numlock enabled
}

input type:touchpad {
    tap enabled
    natural_scroll disabled
    dwt enabled
}

### Idle / lock
exec swayidle -w \
    timeout 600  'swaylock -f -C ~/.cache/wallust/swaylock' \
    timeout 900  'swaymsg "output * power off"' \
          resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -C ~/.cache/wallust/swaylock'

### Autostart
exec foot --server
exec ~/.local/bin/wallpaper
exec mako --config ~/.cache/wallust/mako
exec ~/.local/bin/quick-panel-service --daemon
exec wl-paste --watch cliphist store
exec ~/.local/bin/nightlight on
exec foot --app-id=scratchpad

### Bar
bar {
    swaybar_command waybar
}

### Keys: programs
bindsym $mod+Return exec $term
bindsym $mod+space exec $menu
bindsym $mod+Escape reload
bindsym $mod+alt+Escape exec swaynag -t warning -m 'Exit sway?' -B 'Exit' 'swaymsg exit'
bindsym $mod+shift+Escape exec swaylock -f -C ~/.cache/wallust/swaylock
bindsym $mod+x exec ~/.local/bin/powermenu
bindsym $mod+v exec cliphist list | fuzzel --dmenu --prompt 'clipboard> ' --width 60 | cliphist decode | wl-copy

bindsym $mod+F1 [app_id="scratchpad"] scratchpad show
bindsym $mod+F2 exec $term --app-id=yazi yazi
bindsym $mod+F3 exec thunar
bindsym $mod+F4 exec microsoft-edge-stable
bindsym $mod+F5 exec $term --app-id=ncmpcpp ncmpcpp
bindsym $mod+F6 exec spotify
bindsym $mod+F7 exec $term --app-id=weechat weechat
bindsym $mod+F8 exec gimp
bindsym $mod+F9 exec pavucontrol
bindsym $mod+F10 exec qbittorrent
bindsym XF86Calculator exec $term --app-id=python python

bindsym Print exec ~/.local/bin/screenshot area
bindsym shift+Print exec ~/.local/bin/screenshot full

### Keys: windows
bindsym $mod+w kill
bindsym $mod+shift+w kill

# Monocle-ish: toggle tabbed layout for the current container
bindsym $mod+m layout toggle tabbed split
bindsym $mod+t floating disable
bindsym $mod+s floating toggle
bindsym $mod+f fullscreen toggle
bindsym $mod+shift+t sticky toggle

bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right
bindsym $mod+shift+$left  move left
bindsym $mod+shift+$down  move down
bindsym $mod+shift+$up    move up
bindsym $mod+shift+$right move right

bindsym $mod+p focus parent
bindsym $mod+comma focus child
bindsym $mod+c focus next sibling
bindsym $mod+shift+c focus prev sibling
bindsym $mod+g focus mode_toggle

# Preselect (bspwm) -> choose split direction for the next window
bindsym $mod+ctrl+$left  splith
bindsym $mod+ctrl+$right splith
bindsym $mod+ctrl+$down  splitv
bindsym $mod+ctrl+$up    splitv
bindsym $mod+ctrl+space  split none

# Resize: alt grows, alt+shift shrinks
bindsym $mod+alt+$left  resize grow   width  20px
bindsym $mod+alt+$down  resize grow   height 20px
bindsym $mod+alt+$up    resize grow   height 20px
bindsym $mod+alt+$right resize grow   width  20px
bindsym $mod+alt+shift+$left  resize shrink width  20px
bindsym $mod+alt+shift+$down  resize shrink height 20px
bindsym $mod+alt+shift+$up    resize shrink height 20px
bindsym $mod+alt+shift+$right resize shrink width  20px

# Move floating windows
bindsym $mod+Left  move left  20px
bindsym $mod+Down  move down  20px
bindsym $mod+Up    move up    20px
bindsym $mod+Right move right 20px
floating_modifier $mod normal

bindsym $mod+minus gaps inner current minus 11
bindsym $mod+equal gaps inner current plus 11

### Keys: workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+shift+1 move container to workspace number 1
bindsym $mod+shift+2 move container to workspace number 2
bindsym $mod+shift+3 move container to workspace number 3
bindsym $mod+shift+4 move container to workspace number 4
bindsym $mod+shift+5 move container to workspace number 5
bindsym $mod+shift+6 move container to workspace number 6
bindsym $mod+shift+7 move container to workspace number 7
bindsym $mod+shift+8 move container to workspace number 8
bindsym $mod+shift+9 move container to workspace number 9
bindsym $mod+shift+0 move container to workspace number 10

bindsym $mod+semicolon  workspace prev_on_output
bindsym $mod+apostrophe workspace next_on_output
bindsym $mod+Tab workspace back_and_forth


### Keys: media
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp exec brightnessctl -q set 5%+ && pkill -RTMIN+8 -x waybar
bindsym --locked XF86MonBrightnessDown exec brightnessctl -q set 5%- && pkill -RTMIN+8 -x waybar
bindsym --locked XF86AudioPlay exec mpc toggle
bindsym --locked XF86AudioNext exec mpc next
bindsym --locked XF86AudioPrev exec mpc prev

### Window rules (were bspc rules)
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable
for_window [class="qBittorrent"] move container to workspace number 1, workspace number 1
for_window [app_id="org.qbittorrent.qBittorrent"] move container to workspace number 1, workspace number 1
for_window [app_id="gimp"] floating enable, move container to workspace number 1, workspace number 1
for_window [class="Gimp"] floating enable, move container to workspace number 1, workspace number 1
for_window [app_id="^microsoft-edge"] move container to workspace number 2, workspace number 2
for_window [class="^Microsoft-edge"] move container to workspace number 2, workspace number 2
for_window [app_id="ncmpcpp"] move container to workspace number 3, workspace number 3
for_window [class="Spotify"] move container to workspace number 3, workspace number 3
for_window [app_id="spotify"] move container to workspace number 3, workspace number 3

# Scratchpad terminal (replaces the old xdo/urxvt scratchpad)
for_window [app_id="scratchpad"] floating enable, resize set 800 450, move position center, sticky enable, move scratchpad

# Arch's systemd/portal glue (sets WAYLAND_DISPLAY etc. for user services)
include /etc/sway/config.d/*
